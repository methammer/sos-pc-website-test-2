---
import Navbar from '../components/Navbar.astro';
import AsciiBackground from '../components/AsciiBackground.astro';
import CoverPage from '../components/CoverPage.astro'; // Import the CoverPage component

interface Props {
	title: string;
	description?: string;
}

const { title, description = "SOS-PC - Solutions informatiques et web" } = Astro.props;
const maxNavbarHeight = "80px"; // Adjusted navbar height
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/logo.png" /> {/* Updated favicon path */}
		<meta name="generator" content={Astro.generator} />
		<title>{title} | SOS-PC</title>
		{/* Add Open Graph og:image meta tag if not already present, or update existing one */}
		<meta property="og:image" content="/logo.png" /> {/* Updated OG image path */}
		<style define:vars={{ maxNavbarHeight }}>
			html {
				scroll-padding-top: var(--maxNavbarHeight);
				scroll-behavior: smooth;
			}
      /* Prevent scroll on body while cover page is active */
      body.cover-active {
        overflow: hidden;
        /* On some systems, scrollbar might still be there, taking space.
           This is a common issue. For a perfect solution, more complex JS might be needed
           to calculate scrollbar width and add padding, or use position:fixed on body.
           For now, overflow:hidden is the simplest approach. */
      }
		</style>
		{/* Inline script to set initial theme to prevent FOUC (Flash of Unstyled Content) */}
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark'); // Ensure light is default if no class
			}
		</script>
	</head>
	<body>
    <CoverPage /> {/* Add CoverPage here, it will control its own visibility */}
    <AsciiBackground />
		<Navbar />
		<main tabindex="-1"> {/* Added tabindex for programmatic focus */}
			<slot />
		</main>
		<footer>
			<p>&copy; {new Date().getFullYear()} SOS-PC. Tous droits réservés.</p>
		</footer>
    <script>
      // Script to add/remove 'cover-active' class on body based on CoverPage state
      document.addEventListener('DOMContentLoaded', () => {
        const coverPage = document.getElementById('sos-pc-cover-page'); // ID from CoverPage.astro
        const body = document.body;
        const dismissedKey = 'sospc_cover_dismissed_session_v1'; // Must match key in CoverPage.astro

        if (!coverPage) return;

        function updateBodyScrollState() {
          let isCoverDismissedBySession = false;
          try {
            isCoverDismissedBySession = sessionStorage.getItem(dismissedKey) === 'true';
          } catch(e) { /* ignore */ }

          // If coverPage has 'dismissed' class OR if it was dismissed in session (and might be hidden by its own script)
          if (coverPage.classList.contains('dismissed') || isCoverDismissedBySession) {
            body.classList.remove('cover-active');
          } else {
            body.classList.add('cover-active');
          }
        }

        updateBodyScrollState(); // Set initial state

        // Observe CoverPage for class changes (when it gets 'dismissed')
        const observer = new MutationObserver((mutationsList) => {
          for (const mutation of mutationsList) {
            if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
              updateBodyScrollState();
              // If cover is now dismissed, we can stop observing
              if (coverPage.classList.contains('dismissed')) {
                observer.disconnect();
              }
              break; // Only need to check one mutation if class attribute changed
            }
          }
        });
        
        // Only start observing if the cover page is not already dismissed by session logic
        // (The CoverPage.astro script handles adding 'dismissed' class if session key is found)
        if (!coverPage.classList.contains('dismissed')) {
            observer.observe(coverPage, { attributes: true, attributeFilter: ['class'] });
        }
      });
    </script>


		<!-- ===== SOS-PC ASSISTANT FLOTTANT v4 ===== -->
		<div id="sospc-widget">
			<button id="sospc-fab" onclick="sospcToggle()" aria-label="Assistant SOS-PC">
				<span>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
				</span>
				<span id="sospc-fab-text">Diagnostic PC</span>
				<span id="sospc-fab-badge" style="display:none">!</span>
			</button>

			<div id="sospc-panel">
				<div id="sospc-header">
					<div>
						<span id="sospc-header-title">Assistant SOS-PC</span>
						<span id="sospc-header-sub">Diagnostic intelligent</span>
					</div>
					<div style="display:flex;gap:6px;align-items:center;">
						<button id="sospc-reset-btn" onclick="sospcReset()" title="Nouveau diagnostic">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.5"/></svg>
						</button>
						<button id="sospc-close-btn" onclick="sospcToggle()" aria-label="Fermer">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
						</button>
					</div>
				</div>

				<!-- Vue : en attente du script -->
				<div id="sospc-view-waiting">
					<div id="sospc-waiting-body">
						<p id="sospc-intro-title">Analysez votre PC gratuitement</p>
						<p id="sospc-intro-desc">Notre IA détecte les problèmes de performance, les erreurs système et vous donne des conseils personnalisés.</p>

						<div id="sospc-steps">
							<div class="sospc-step">
								<span class="sospc-step-n">1</span>
								<span>Ouvrez le Terminal (<kbd>Win</kbd>+<kbd>X</kbd> → Terminal)</span>
							</div>
							<div class="sospc-step">
								<span class="sospc-step-n">2</span>
								<span>Copiez et collez cette commande :</span>
							</div>
						</div>

						<div id="sospc-cmd-box">
							<code id="sospc-cmd">chargement...</code>
							<button id="sospc-copy-btn" onclick="sospcCopy()">Copier</button>
						</div>

						<div class="sospc-step">
							<span class="sospc-step-n">3</span>
							<span>Restez sur cette page — le diagnostic apparaît automatiquement ici !</span>
						</div>

						<div id="sospc-waiting-indicator" style="display:none;">
							<div id="sospc-pulse"></div>
							<span>En attente des données de votre PC...</span>
						</div>

						<p id="sospc-privacy">🔒 Aucun fichier personnel collecté — uniquement les données techniques.</p>
					</div>
				</div>

				<!-- Vue : diagnostic + chat -->
				<div id="sospc-view-diag" style="display:none;flex-direction:column;">
					<div id="sospc-score-wrap">
						<span id="sospc-score-lbl">Santé du PC</span>
						<div id="sospc-score-track"><div id="sospc-score-fill"></div></div>
						<span id="sospc-score-val">—</span>
					</div>
					<div id="sospc-messages"></div>
					<div id="sospc-suggestions"></div>
					<div id="sospc-input-wrap">
						<input id="sospc-input" type="text" placeholder="Posez une question..." onkeydown="if(event.key==='Enter')sospcSend()" />
						<button id="sospc-send" onclick="sospcSend()">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
						</button>
					</div>
				</div>
			</div>
		</div>

		<style>
		body.cover-active #sospc-widget { display: none !important; }

		#sospc-widget {
			position: fixed; bottom: 24px; right: 24px; z-index: 9999;
			display: flex; flex-direction: column; align-items: flex-end; gap: 12px;
			font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		}
		#sospc-fab {
			display: flex; align-items: center; gap: 8px;
			background: rgb(var(--accent)); color: white; border: none;
			border-radius: 50px; padding: 12px 20px; font-size: 14px; font-weight: 600;
			cursor: pointer; box-shadow: 0 4px 16px rgba(136,58,234,0.4);
			transition: transform 0.2s, box-shadow 0.2s; white-space: nowrap;
		}
		#sospc-fab:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(136,58,234,0.5); }
		#sospc-fab-badge {
			background: #E24B4A; color: white; border-radius: 50%;
			width: 18px; height: 18px; font-size: 11px; font-weight: 700;
			display: flex; align-items: center; justify-content: center;
		}
		#sospc-panel {
			width: 360px; background: var(--card-bg-color);
			border: 1px solid var(--border-color); border-radius: 16px;
			box-shadow: 0 8px 40px rgba(0,0,0,0.18); display: none;
			flex-direction: column; overflow: hidden; max-height: 80vh;
		}
		#sospc-panel.open { display: flex; }
		#sospc-header {
			background: rgb(var(--accent)); padding: 12px 16px;
			display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;
		}
		#sospc-header-title { display: block; color: white; font-size: 14px; font-weight: 600; }
		#sospc-header-sub { display: block; color: rgba(255,255,255,0.75); font-size: 11px; }
		#sospc-close-btn, #sospc-reset-btn {
			background: none; border: none; color: white; cursor: pointer; opacity: 0.75;
			padding: 4px; border-radius: 6px; display: flex; align-items: center; justify-content: center;
			transition: opacity 0.2s, background 0.2s;
		}
		#sospc-close-btn:hover, #sospc-reset-btn:hover { opacity: 1; background: rgba(255,255,255,0.15); }

		/* Vue attente */
		#sospc-waiting-body { padding: 16px; overflow-y: auto; }
		#sospc-intro-title { font-size: 15px; font-weight: 600; color: var(--heading-color); margin: 0 0 6px; }
		#sospc-intro-desc { font-size: 13px; color: var(--card-text-color); margin: 0 0 14px; line-height: 1.5; }
		#sospc-steps { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
		.sospc-step { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; color: var(--card-text-color); }
		.sospc-step-n {
			width: 22px; height: 22px; border-radius: 50%; background: rgb(var(--accent)); color: white;
			font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
		}
		.sospc-step kbd {
			background: var(--bg-color); border: 1px solid var(--border-color);
			border-radius: 4px; padding: 1px 5px; font-size: 11px; font-family: inherit; color: var(--text-color);
		}
		#sospc-cmd-box {
			background: #1a1a2e; border-radius: 8px; padding: 10px 12px;
			display: flex; align-items: center; gap: 10px; margin-bottom: 10px;
		}
		#sospc-cmd { color: #a78bfa; font-size: 12px; font-family: 'Courier New', monospace; flex: 1; word-break: break-all; }
		#sospc-copy-btn {
			background: rgba(136,58,234,0.3); color: #c4b5fd;
			border: 1px solid rgba(167,139,250,0.3); border-radius: 6px;
			padding: 5px 10px; font-size: 12px; cursor: pointer; flex-shrink: 0; transition: background 0.2s; white-space: nowrap;
		}
		#sospc-copy-btn:hover { background: rgba(136,58,234,0.5); }
		#sospc-copy-btn.copied { background: rgba(29,158,117,0.4); color: #6ee7b7; border-color: rgba(110,231,183,0.3); }

		#sospc-waiting-indicator {
			display: flex; align-items: center; gap: 10px;
			background: rgba(var(--accent), 0.08); border: 1px solid rgba(var(--accent), 0.2);
			border-radius: 8px; padding: 10px 14px; margin: 10px 0; font-size: 13px; color: var(--card-text-color);
		}
		#sospc-pulse {
			width: 10px; height: 10px; border-radius: 50%; background: rgb(var(--accent));
			flex-shrink: 0; animation: sospc-pulse 1.4s ease-in-out infinite;
		}
		@keyframes sospc-pulse {
			0%, 100% { opacity: 1; transform: scale(1); }
			50% { opacity: 0.4; transform: scale(0.7); }
		}
		#sospc-privacy { font-size: 11px; color: var(--card-text-color); opacity: 0.6; text-align: center; margin: 10px 0 0; }

		/* Vue diagnostic */
		#sospc-score-wrap {
			display: flex; align-items: center; gap: 10px; padding: 10px 16px;
			background: var(--bg-color); border-bottom: 1px solid var(--border-color); flex-shrink: 0;
		}
		#sospc-score-lbl { font-size: 12px; color: var(--card-text-color); flex-shrink: 0; }
		#sospc-score-track { flex: 1; height: 6px; background: var(--border-color); border-radius: 3px; overflow: hidden; }
		#sospc-score-fill { height: 100%; border-radius: 3px; width: 0%; transition: width 1.2s ease; }
		#sospc-score-val { font-size: 13px; font-weight: 700; color: var(--heading-color); flex-shrink: 0; min-width: 40px; text-align: right; }
		#sospc-messages {
			flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column;
			gap: 8px; min-height: 100px; max-height: 260px;
		}
		.sospc-msg { max-width: 88%; padding: 9px 12px; border-radius: 12px; font-size: 13px; line-height: 1.5; }
		.sospc-msg.user { background: rgb(var(--accent)); color: white; align-self: flex-end; border-bottom-right-radius: 3px; }
		.sospc-msg.bot { background: var(--bg-color); color: var(--text-color); align-self: flex-start; border-bottom-left-radius: 3px; border: 1px solid var(--border-color); }
		.sospc-msg.typing { opacity: 0.6; font-style: italic; }
		#sospc-suggestions { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 12px 10px; }
		.sospc-suggestion {
			background: rgba(var(--accent-light), 0.2); color: rgb(var(--accent-dark));
			border: 1px solid rgba(var(--accent), 0.2); border-radius: 20px;
			padding: 5px 12px; font-size: 12px; cursor: pointer; transition: background 0.2s; white-space: nowrap;
		}
		.sospc-suggestion:hover { background: rgba(var(--accent-light), 0.4); }
		#sospc-input-wrap { display: flex; gap: 8px; padding: 10px 12px; border-top: 1px solid var(--border-color); flex-shrink: 0; }
		#sospc-input {
			flex: 1; background: var(--bg-color); border: 1px solid var(--border-color);
			border-radius: 20px; padding: 8px 14px; font-size: 13px; color: var(--text-color); outline: none; transition: border 0.2s;
		}
		#sospc-input:focus { border-color: rgb(var(--accent)); }
		#sospc-send {
			background: rgb(var(--accent)); color: white; border: none; border-radius: 50%;
			width: 34px; height: 34px; cursor: pointer; display: flex; align-items: center;
			justify-content: center; flex-shrink: 0; transition: background 0.2s, transform 0.1s;
		}
		#sospc-send:hover { background: rgb(var(--accent-dark)); }
		#sospc-send:active { transform: scale(0.95); }
		#sospc-send:disabled { background: var(--border-color); cursor: default; }

		@media (max-width: 480px) {
			#sospc-panel { width: calc(100vw - 32px); }
			#sospc-widget { bottom: 16px; right: 16px; }
			#sospc-fab-text { display: none; }
			#sospc-fab { padding: 14px; border-radius: 50%; }
		}
		</style>

		<script>
		(function() {
			const STORAGE_KEY = 'sospc_diagnostic_v1';
			let panelOpen = false;
			let diagData = null;
			let diagReport = null;
			let chatHistory = [];
			let sessionId = null;
			let pollInterval = null;

			// ---- Storage ----
			function save() {
				try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ diagData, diagReport, chatHistory, savedAt: Date.now() })); } catch(e) {}
			}
			function load() {
				try { const r = localStorage.getItem(STORAGE_KEY); return r ? JSON.parse(r) : null; } catch(e) { return null; }
			}
			function clear() {
				try { localStorage.removeItem(STORAGE_KEY); } catch(e) {}
			}

			// ---- Session ID ----
			function genId() {
				return Math.random().toString(36).slice(2, 10).toUpperCase();
			}

			// ---- Commande ----
			function buildCmd(sid) {
				return `$s='${sid}'; irm https://sos-pc.click/diag.ps1 | iex`;
			}

			// ---- Toggle ----
			window.sospcToggle = function() {
				panelOpen = !panelOpen;
				document.getElementById('sospc-panel').classList.toggle('open', panelOpen);
				document.getElementById('sospc-fab-badge').style.display = 'none';
				if (panelOpen && !diagData && !pollInterval) startPolling();
				if (panelOpen && diagData) setTimeout(() => { const i = document.getElementById('sospc-input'); if(i) i.focus(); }, 200);
			};

			// ---- Copier ----
			window.sospcCopy = function() {
				navigator.clipboard.writeText(document.getElementById('sospc-cmd').textContent).then(() => {
					const btn = document.getElementById('sospc-copy-btn');
					btn.textContent = 'Copié !'; btn.classList.add('copied');
					// Afficher indicateur d'attente
					document.getElementById('sospc-waiting-indicator').style.display = 'flex';
					setTimeout(() => { btn.textContent = 'Copier'; btn.classList.remove('copied'); }, 2500);
				});
			};

			// ---- Reset ----
			window.sospcReset = function() {
				if (!confirm('Relancer un nouveau diagnostic ?')) return;
				stopPolling(); clear();
				diagData = null; diagReport = null; chatHistory = [];
				// Nouveau session ID
				sessionId = genId();
				document.getElementById('sospc-cmd').textContent = buildCmd(sessionId);
				// Revenir vue attente
				document.getElementById('sospc-view-diag').style.display = 'none';
				document.getElementById('sospc-view-waiting').style.display = 'block';
				document.getElementById('sospc-waiting-indicator').style.display = 'none';
				document.getElementById('sospc-header-sub').textContent = 'Diagnostic intelligent';
				document.getElementById('sospc-fab-text').textContent = 'Diagnostic PC';
				document.getElementById('sospc-messages').innerHTML = '';
				document.getElementById('sospc-suggestions').innerHTML = '';
			};

			// ---- Polling ----
			function startPolling() {
				if (pollInterval) return;
				pollInterval = setInterval(async () => {
					try {
						const r = await fetch(`/api/poll?s=${sessionId}`);
						const json = await r.json();
						if (json.ready && json.data) {
							stopPolling();
							diagData = json.data;
							document.getElementById('sospc-waiting-indicator').style.display = 'none';
							runAnalysis();
						}
					} catch(e) {}
				}, 2000);
			}

			function stopPolling() {
				if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
			}

			// ---- Switch vues ----
			function showDiagView() {
				document.getElementById('sospc-view-waiting').style.display = 'none';
				const v = document.getElementById('sospc-view-diag');
				v.style.display = 'flex'; v.style.flexDirection = 'column';
			}

			// ---- Messages ----
			function addMsg(role, text) {
				const box = document.getElementById('sospc-messages');
				const div = document.createElement('div');
				div.className = 'sospc-msg ' + role;
				div.textContent = text;
				box.appendChild(div);
				box.scrollTop = box.scrollHeight;
				return div;
			}

			function renderHistory() {
				const box = document.getElementById('sospc-messages');
				box.innerHTML = '';
				chatHistory.forEach(m => {
					const div = document.createElement('div');
					div.className = 'sospc-msg ' + (m.role === 'user' ? 'user' : 'bot');
					div.textContent = m.content;
					box.appendChild(div);
				});
				box.scrollTop = box.scrollHeight;
			}

			function setScore(score) {
				const fill = document.getElementById('sospc-score-fill');
				fill.style.background = score >= 70 ? '#1D9E75' : score >= 40 ? '#BA7517' : '#E24B4A';
				document.getElementById('sospc-score-val').textContent = score + '/100';
				setTimeout(() => fill.style.width = score + '%', 100);
			}

			function showSuggestions(items) {
				const wrap = document.getElementById('sospc-suggestions');
				wrap.innerHTML = '';
				items.forEach(text => {
					const btn = document.createElement('button');
					btn.className = 'sospc-suggestion'; btn.textContent = text;
					btn.onclick = () => { wrap.innerHTML = ''; document.getElementById('sospc-input').value = text; sospcSend(); };
					wrap.appendChild(btn);
				});
			}

			// ---- Analyse IA ----
			function runAnalysis() {
				showDiagView();
				document.getElementById('sospc-header-sub').textContent = 'Analyse en cours...';
				// Ouvrir le panel si fermé
				if (!panelOpen) {
					panelOpen = true;
					document.getElementById('sospc-panel').classList.add('open');
				}
				const typing = addMsg('bot typing', 'Analyse de votre PC en cours...');

				fetch('https://sos-pc-diagnostic.netlify.app/api/analyze', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ data: diagData, problem: '' })
				})
				.then(r => r.json())
				.then(json => {
					diagReport = json.report;
					typing.remove();
					const score = diagReport?.score || 50;
					setScore(score);
					document.getElementById('sospc-header-sub').textContent = 'Diagnostic terminé';
					document.getElementById('sospc-fab-text').textContent = 'Voir le diagnostic';

					const summary = diagReport?.summary || 'Analyse terminée.';
					addMsg('bot', summary);
					chatHistory.push({ role: 'assistant', content: summary });

					const crits = (diagReport?.issues || []).filter(i => i.level === 'critical');
					if (crits.length) {
						const msg = '⚠️ ' + crits.length + ' problème(s) critique(s) : ' + crits.map(i => i.title).join(', ') + '.';
						addMsg('bot', msg);
						chatHistory.push({ role: 'assistant', content: msg });
					}

					// Proposer services SOS-PC si problèmes détectés
					const hasIssues = (diagReport?.issues || []).some(i => i.level !== 'ok');
					if (hasIssues) {
						const cta = 'Nos techniciens peuvent résoudre ces problèmes à distance ou à domicile. Voulez-vous qu\'on vous contacte ?';
						addMsg('bot', cta);
						chatHistory.push({ role: 'assistant', content: cta });
					}

					showSuggestions(['Expliquer le problème principal', 'Améliorer les performances', 'Contacter SOS-PC']);
					save();
				})
				.catch(() => {
					typing.remove();
					addMsg('bot', 'Erreur lors de l\'analyse. Contactez-nous directement au 07 69 56 14 91.');
					document.getElementById('sospc-header-sub').textContent = 'Erreur';
				});
			}

			// ---- Chat ----
			window.sospcSend = function() {
				const input = document.getElementById('sospc-input');
				const msg = input.value.trim();
				if (!msg) return;
				input.value = '';
				document.getElementById('sospc-send').disabled = true;
				document.getElementById('sospc-suggestions').innerHTML = '';
				addMsg('user', msg);
				chatHistory.push({ role: 'user', content: msg });
				const typing = addMsg('bot typing', '...');

				fetch('https://sos-pc-diagnostic.netlify.app/api/chat', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ messages: chatHistory, systemData: diagData, report: diagReport })
				})
				.then(r => r.json())
				.then(json => {
					typing.remove();
					const reply = json.message || 'Désolé, une erreur est survenue.';
					addMsg('bot', reply);
					chatHistory.push({ role: 'assistant', content: reply });
					save();
				})
				.catch(() => { typing.remove(); addMsg('bot', 'Erreur de connexion. Veuillez réessayer.'); })
				.finally(() => { document.getElementById('sospc-send').disabled = false; input.focus(); });
			};

			// ---- Init ----
			document.addEventListener('DOMContentLoaded', function() {
				const saved = load();
				if (saved && saved.diagData) {
					// Données existantes — charger silencieusement
					diagData = saved.diagData;
					diagReport = saved.diagReport;
					chatHistory = saved.chatHistory || [];
					showDiagView();
					if (diagReport) setScore(diagReport.score || 50);
					renderHistory();
					if (diagReport) showSuggestions(['Rappelle-moi le résumé', 'Améliorer les performances', 'Contacter SOS-PC']);
					document.getElementById('sospc-header-sub').textContent = 'Diagnostic sauvegardé';
					document.getElementById('sospc-fab-text').textContent = 'Voir le diagnostic';
					document.getElementById('sospc-fab-badge').style.display = 'flex';
				} else {
					// Pas de données — générer session ID et attendre
					sessionId = genId();
					document.getElementById('sospc-cmd').textContent = buildCmd(sessionId);
				}
			});
		})();
		</script>

</body>
</html>
