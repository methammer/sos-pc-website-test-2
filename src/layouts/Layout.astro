---
import AsciiBackground from '../components/AsciiBackground.astro';
import Navbar from '../components/Navbar.astro';
import CoverPage from '../components/CoverPage.astro';

interface Props {
  title?: string;
}
const { title = 'SOS-PC' } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Depannage PC, reparation informatique et creation de sites web a Le Castellet (04700). SOS-PC, intervention rapide dans les Alpes-de-Haute-Provence. Diagnostic IA gratuit." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="keywords" content="depannage informatique 04700, reparation PC Le Castellet, technicien informatique Alpes-Haute-Provence" />
    <meta name="author" content="SOS-PC" />
    <link rel="canonical" href="https://sos-pc.click" />
    <meta property="og:title" content="SOS-PC  Depannage informatique Le Castellet 04700" />
    <meta property="og:description" content="Diagnostic IA gratuit, reparation PC et creation web dans les Alpes-de-Haute-Provence." />
    <meta property="og:image" content="https://sos-pc.click/logo.png" />
    <meta property="og:url" content="https://sos-pc.click" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="SOS-PC  Depannage informatique Le Castellet" />
    <meta name="twitter:image" content="https://sos-pc.click/logo.png" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "SOS-PC",
      "description": "Depannage informatique, reparation PC et creation de sites web",
      "telephone": "+33769561491",
      "email": "sos.pc.04@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Le Castellet",
        "postalCode": "04700",
        "addressCountry": "FR"
      },
      "url": "https://sos-pc.click",
      "areaServed": "Alpes-de-Haute-Provence"
    }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      (function() {
        var theme = localStorage.getItem("theme");
        if (theme === "light") {
          document.documentElement.classList.remove("dark");
        } else {
          document.documentElement.classList.add("dark");
          if (!theme) localStorage.setItem("theme", "dark");
        }
      })();
    </script>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <CoverPage />
    <AsciiBackground />
    <Navbar />
    <main>
      <slot />
    </main>
    <footer>
      <p><span class="mono">© 2026</span> SOS-PC — Tous droits réservés</p>
    </footer>

    <!-- ===== SOS-PC ASSISTANT FLOTTANT v7 ===== -->
    <div id="sospc-widget" class="sospc-closed">
      <div id="sospc-fab-content">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span id="sospc-fab-text">Diagnostic PC</span>
        <span id="sospc-fab-badge" style="display:none">!</span>
      </div>
      <div id="sospc-panel-content">
        <div id="sospc-header">
          <div>
            <span id="sospc-header-title">Assistant SOS-PC</span>
            <span id="sospc-header-sub">Diagnostic intelligent</span>
          </div>
          <div style="display:flex;gap:6px;align-items:center;">
            <button id="sospc-reset-btn" onclick="sospcReset()" title="Nouveau scan">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.5"/></svg>
              Nouveau scan
            </button>
            <button id="sospc-close-btn" onclick="sospcToggle()" aria-label="Fermer">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        </div>
        <div id="sospc-view-waiting">
          <div id="sospc-waiting-body">
            <p id="sospc-intro-title">Analysez votre PC gratuitement</p>
            <p id="sospc-intro-desc">Notre IA détecte les problèmes de performance, les erreurs système et vous donne des conseils personnalisés.</p>
            <div id="sospc-steps">
              <div class="sospc-step"><span class="sospc-step-n">1</span><span>Ouvrez le Terminal (<kbd>Win</kbd>+<kbd>X</kbd> → Terminal)</span></div>
              <div class="sospc-step"><span class="sospc-step-n">2</span><span>Copiez et collez cette commande :</span></div>
            </div>
            <div id="sospc-cmd-box">
              <code id="sospc-cmd">chargement...</code>
              <button id="sospc-copy-btn" onclick="sospcCopy()">Copier</button>
            </div>
            <div class="sospc-step"><span class="sospc-step-n">3</span><span>Restez sur cette page — le diagnostic apparaît automatiquement ici !</span></div>
            <div id="sospc-waiting-indicator" style="display:none;"><div id="sospc-pulse"></div><span>En attente des données...</span></div>
            <p id="sospc-privacy">🔒 Aucun fichier personnel collecté.</p>
          </div>
        </div>
        <div id="sospc-view-diag" style="display:none;flex-direction:column;">
          <div id="sospc-score-wrap">
            <span id="sospc-score-lbl">Santé du PC</span>
            <div id="sospc-score-track"><div id="sospc-score-fill"></div></div>
            <span id="sospc-score-val">—</span>
          </div>
          <div id="sospc-messages"></div>
          <div id="sospc-suggestions"></div>
          <div id="sospc-attach-bar" style="display:none;">
            <button id="sospc-attach-btn" onclick="sospcAttachToForm()">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
              Joindre au formulaire de contact
            </button>
          </div>
          <div id="sospc-input-wrap">
            <input id="sospc-input" type="text" placeholder="Posez une question..." onkeydown="if(event.key==='Enter')sospcSend()" />
            <button id="sospc-send" onclick="sospcSend()">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  /* ===========================
     TOKYO NIGHT — PALETTE
  =========================== */
  :root {
    --bg:          #1a1b26;
    --bg-card:     #24283b;
    --bg-elevated: #2a2e42;
    --bg-overlay:  #1e2030;
    --border:      #3b4261;
    --border-glow: #00d4aa;
    --text:        #c0caf5;
    --text-muted:  #7982a9;
    --text-dim:    #565f89;
    --accent:      0, 212, 170;
    --accent-hex:  #00d4aa;
    --accent-dim:  #004d3f;
    --accent-light: 150, 255, 230;
    --accent-dark: 0, 100, 80;
    --yellow:      #e0af68;
    --red:         #f7768e;
    --blue:        #7aa2f7;
    --purple:      #bb9af7;
    --orange:      #ff9e64;
    --navbar-h:    64px;
    --maxNavbarHeight: 64px;
    --font-mono:   'JetBrains Mono', monospace;
    --font-body:   'Outfit', sans-serif;
    --radius:      6px;
    --radius-lg:   12px;
    --bg-color:         var(--bg);
    --text-color:       var(--text);
    --card-bg-color:    var(--bg-card);
    --card-text-color:  var(--text);
    --border-color:     var(--border);
    --heading-color:    var(--accent-hex);
    --button-bg-color:  rgb(var(--accent));
    --section-separator-color: var(--accent-hex);
    --navbar-bg-color:  rgba(26, 27, 38, 0.92);
    --input-focus-border-color: var(--accent-hex);
    --input-focus-shadow-color: rgba(0, 212, 170, 0.2);
    --scroll-padding-top: var(--navbar-h);
  }

  html:not(.dark) {
    --bg:          #f0f4f8;
    --bg-card:     #ffffff;
    --bg-elevated: #e8edf2;
    --border:      #c8d0dc;
    --text:        #1a1b26;
    --text-muted:  #565f89;
    --text-dim:    #7982a9;
    --accent-hex:  #007a62;
    --accent-dim:  #d0f0ea;
    --bg-color:    #f0f4f8;
    --navbar-bg-color: rgba(240, 244, 248, 0.92);
    --card-bg-color: #ffffff;
    --border-color: #c8d0dc;
    --heading-color: #007a62;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--navbar-h);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  body {
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
  }

  body::before { display: none;
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,212,170,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,212,170,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  main {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .mono { font-family: var(--font-mono); }

  h1, h2, h3 {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
  }

  a { color: var(--accent-hex); text-decoration: none; transition: opacity 0.2s; }
  a:hover { opacity: 0.8; }

  footer {
    position: relative; z-index: 1;
    text-align: center;
    padding: 2rem;
    color: var(--text-dim);
    font-size: 13px;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
  }

  section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--border);
  }
  section:last-of-type { border-bottom: none; }

  .glow { box-shadow: 0 0 20px rgba(0, 212, 170, 0.15), 0 0 40px rgba(0, 212, 170, 0.05); }
  .glow-text { text-shadow: 0 0 20px rgba(0, 212, 170, 0.4); }

  .tag {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--font-mono);
    font-size: 11px; font-weight: 500;
    padding: 3px 10px;
    border-radius: 3px;
    border: 1px solid;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .tag-teal   { color: var(--accent-hex); border-color: var(--accent-hex); background: rgba(0,212,170,0.08); }
  .tag-yellow { color: var(--yellow);     border-color: var(--yellow);     background: rgba(224,175,104,0.08); }
  .tag-blue   { color: var(--blue);       border-color: var(--blue);       background: rgba(122,162,247,0.08); }
  .tag-red    { color: var(--red);        border-color: var(--red);        background: rgba(247,118,142,0.08); }
  .tag-purple { color: var(--purple);     border-color: var(--purple);     background: rgba(187,154,247,0.08); }

  .btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgb(var(--accent));
    color: #1a1b26;
    border: none;
    border-radius: var(--radius);
    padding: 11px 24px;
    font-size: 14px; font-weight: 600;
    font-family: var(--font-mono);
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }
  .btn-primary:hover {
    background: rgba(var(--accent), 0.85);
    color: #1a1b26; opacity: 1;
    box-shadow: 0 0 20px rgba(0, 212, 170, 0.3);
    transform: translateY(-1px);
  }

  .btn-ghost {
    display: inline-flex; align-items: center; gap: 8px;
    background: transparent;
    color: var(--accent-hex);
    border: 1px solid var(--accent-hex);
    border-radius: var(--radius);
    padding: 11px 24px;
    font-size: 14px; font-weight: 500;
    font-family: var(--font-mono);
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }
  .btn-ghost:hover {
    background: rgba(0,212,170,0.08); opacity: 1;
    box-shadow: 0 0 15px rgba(0, 212, 170, 0.15);
  }

  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--accent-hex); }

  /* ===========================
     CHATBOT — Tokyo Night
  =========================== */
  body.cover-active #sospc-widget { display: none !important; }
  
  #sospc-widget {
    position: fixed; bottom: 24px; right: 24px; z-index: 9999;
    font-family: var(--font-body);
    transform-origin: bottom right;
    transition: width 0.38s cubic-bezier(0.34,1.3,0.64,1), border-radius 0.38s cubic-bezier(0.34,1.3,0.64,1), box-shadow 0.38s ease, background 0.2s ease;
  }
  #sospc-widget.sospc-snapping {
    transition: left 0.32s cubic-bezier(0.34,1.2,0.64,1), top 0.32s cubic-bezier(0.34,1.2,0.64,1), width 0.38s cubic-bezier(0.34,1.3,0.64,1), border-radius 0.38s cubic-bezier(0.34,1.3,0.64,1), box-shadow 0.38s ease, background 0.2s ease;
  }
  #sospc-widget.sospc-dragging { transition: none !important; user-select: none; }
  #sospc-widget.sospc-closed {
    width: auto; border-radius: 4px;
    background: var(--bg-card);
    border: 1px solid var(--accent-hex);
    box-shadow: 0 0 16px rgba(0,212,170,0.2);
    overflow: hidden; cursor: pointer;
  }
  #sospc-widget.sospc-closed:not(.sospc-dragging):hover {
    transform: translateY(-2px);
    box-shadow: 0 0 24px rgba(0,212,170,0.35);
  }
  #sospc-widget.sospc-open {
    width: 360px; border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border);
    box-shadow: 0 8px 40px rgba(0,0,0,0.5), 0 0 0 1px rgba(0,212,170,0.1);
    overflow: hidden; cursor: default;
  }
  #sospc-fab-content {
    display: flex; align-items: center; gap: 8px;
    padding: 11px 18px; color: var(--accent-hex);
    font-size: 13px; font-weight: 600; font-family: var(--font-mono);
    white-space: nowrap; user-select: none; touch-action: none;
  }
  #sospc-widget.sospc-open #sospc-fab-content { display: none; }
  #sospc-fab-badge {
    background: var(--red); color: #1a1b26; border-radius: 3px;
    width: 18px; height: 18px; font-size: 10px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono);
  }
  #sospc-panel-content {
    display: none; flex-direction: column; opacity: 0;
    transition: opacity 0.2s ease 0.15s; max-height: 80vh; overflow: hidden;
  }
  #sospc-widget.sospc-open #sospc-panel-content { display: flex; opacity: 1; }
  #sospc-header {
    background: var(--bg-elevated); padding: 12px 16px;
    display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;
    cursor: grab; user-select: none; touch-action: none;
    border-bottom: 1px solid var(--accent-hex);
  }
  #sospc-header:active { cursor: grabbing; }
  #sospc-header-title { display: block; color: var(--accent-hex); font-size: 13px; font-weight: 600; font-family: var(--font-mono); }
  #sospc-header-sub { display: block; color: var(--text-muted); font-size: 11px; font-family: var(--font-mono); }
  #sospc-close-btn, #sospc-reset-btn {
    background: none; border: none; color: var(--text-muted); cursor: pointer;
    opacity: 0.75; padding: 4px 8px; border-radius: var(--radius);
    display: flex; align-items: center; gap: 5px; font-size: 11px; font-family: var(--font-mono);
    transition: opacity 0.2s, background 0.2s;
  }
  #sospc-close-btn { padding: 4px; }
  #sospc-close-btn:hover, #sospc-reset-btn:hover { opacity: 1; background: rgba(0,212,170,0.1); color: var(--accent-hex); }
  #sospc-waiting-body { padding: 16px; overflow-y: auto; }
  #sospc-intro-title { font-size: 14px; font-weight: 600; color: var(--text); margin: 0 0 6px; font-family: var(--font-mono); }
  #sospc-intro-desc { font-size: 13px; color: var(--text-muted); margin: 0 0 14px; line-height: 1.5; }
  #sospc-steps { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
  .sospc-step { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; color: var(--text-muted); }
  .sospc-step-n {
    width: 20px; height: 20px; border-radius: 3px; background: rgba(0,212,170,0.15);
    color: var(--accent-hex); font-size: 11px; font-weight: 700; font-family: var(--font-mono);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    border: 1px solid rgba(0,212,170,0.3);
  }
  .sospc-step kbd {
    background: var(--bg-elevated); border: 1px solid var(--border);
    border-radius: 3px; padding: 1px 5px; font-size: 11px; font-family: var(--font-mono); color: var(--text);
  }
  #sospc-cmd-box {
    background: #0d0e14; border-radius: var(--radius); border: 1px solid var(--border);
    padding: 10px 12px; display: flex; align-items: center; gap: 10px; margin-bottom: 10px;
  }
  #sospc-cmd { color: var(--accent-hex); font-size: 12px; font-family: var(--font-mono); flex: 1; word-break: break-all; }
  #sospc-copy-btn {
    background: rgba(0,212,170,0.15); color: var(--accent-hex);
    border: 1px solid rgba(0,212,170,0.3); border-radius: var(--radius);
    padding: 5px 10px; font-size: 11px; font-family: var(--font-mono); cursor: pointer; flex-shrink: 0; transition: background 0.2s;
  }
  #sospc-copy-btn:hover { background: rgba(0,212,170,0.3); }
  #sospc-copy-btn.copied { background: rgba(0,212,170,0.3); }
  #sospc-waiting-indicator {
    display: flex; align-items: center; gap: 10px;
    background: rgba(0,212,170,0.05); border: 1px solid rgba(0,212,170,0.2);
    border-radius: var(--radius); padding: 10px 14px; margin: 10px 0;
    font-size: 12px; color: var(--text-muted); font-family: var(--font-mono);
  }
  #sospc-pulse {
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent-hex); flex-shrink: 0;
    animation: sospc-pulse 1.4s ease-in-out infinite;
  }
  @keyframes sospc-pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(.7)} }
  #sospc-privacy { font-size: 11px; color: var(--text-dim); text-align: center; margin: 10px 0 0; font-family: var(--font-mono); }
  #sospc-score-wrap {
    display: flex; align-items: center; gap: 10px; padding: 10px 16px;
    background: var(--bg-overlay); border-bottom: 1px solid var(--border); flex-shrink: 0;
  }
  #sospc-score-lbl { font-size: 11px; color: var(--text-muted); flex-shrink: 0; font-family: var(--font-mono); }
  #sospc-score-track { flex: 1; height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; }
  #sospc-score-fill { height: 100%; border-radius: 2px; width: 0%; transition: width 1.2s ease; }
  #sospc-score-val { font-size: 12px; font-weight: 700; color: var(--accent-hex); flex-shrink: 0; min-width: 40px; text-align: right; font-family: var(--font-mono); }
  #sospc-messages {
    flex: 1; overflow-y: auto; padding: 12px;
    display: flex; flex-direction: column; gap: 8px; min-height: 100px; max-height: 260px;
  }
  .sospc-msg { max-width: 88%; padding: 9px 12px; border-radius: var(--radius); font-size: 13px; line-height: 1.5; }
  .sospc-msg.user { background: rgba(0,212,170,0.15); color: var(--accent-hex); align-self: flex-end; border: 1px solid rgba(0,212,170,0.3); }
  .sospc-msg.bot { background: var(--bg-elevated); color: var(--text); align-self: flex-start; border: 1px solid var(--border); }
  .sospc-msg.typing { opacity: 0.6; font-style: italic; font-family: var(--font-mono); }
  #sospc-suggestions { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 12px 10px; }
  .sospc-suggestion {
    background: rgba(0,212,170,0.08); color: var(--accent-hex);
    border: 1px solid rgba(0,212,170,0.2); border-radius: var(--radius);
    padding: 4px 10px; font-size: 11px; font-family: var(--font-mono); cursor: pointer; transition: background 0.2s;
  }
  .sospc-suggestion:hover { background: rgba(0,212,170,0.18); }

  /* Bouton joindre au formulaire */
  #sospc-attach-bar { padding: 4px 12px 8px; }
  #sospc-attach-btn {
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;
    background: rgba(0,212,170,0.07); color: var(--accent-hex);
    border: 1px solid rgba(0,212,170,0.22); border-radius: var(--radius);
    padding: 7px 12px; font-size: 11px; font-family: var(--font-mono);
    cursor: pointer; transition: background 0.2s, border-color 0.2s;
  }
  #sospc-attach-btn:hover { background: rgba(0,212,170,0.18); border-color: rgba(0,212,170,0.5); }
  #sospc-attach-btn.attached { background: rgba(0,212,170,0.2); border-color: var(--accent-hex); }

  #sospc-input-wrap { display: flex; gap: 8px; padding: 10px 12px; border-top: 1px solid var(--border); flex-shrink: 0; }
  #sospc-input {
    flex: 1; background: var(--bg-overlay); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 8px 12px; font-size: 13px; color: var(--text); font-family: var(--font-mono);
    outline: none; transition: border 0.2s;
  }
  #sospc-input:focus { border-color: var(--accent-hex); box-shadow: 0 0 8px rgba(0,212,170,0.15); }
  #sospc-send {
    background: var(--accent-hex); color: #1a1b26; border: none;
    border-radius: var(--radius); width: 34px; height: 34px; cursor: pointer;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    transition: all 0.2s;
  }
  #sospc-send:hover { box-shadow: 0 0 12px rgba(0,212,170,0.4); }
  #sospc-send:active { transform: scale(0.95); }
  #sospc-send:disabled { background: var(--border); color: var(--text-dim); cursor: default; box-shadow: none; }

  @media (max-width: 480px) {
    #sospc-widget.sospc-open { width: calc(100vw - 32px); }
    #sospc-widget { bottom: 16px; right: 16px; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const coverPage = document.getElementById("sos-pc-cover-page");
    if (!coverPage) return;
    const body = document.body;
    if (!coverPage.classList.contains("dismissed") && sessionStorage.getItem("sospc_cover_dismissed_session_v1") !== "true") {
      body.classList.add("cover-active");
    }
    new MutationObserver(function(mutations) {
      mutations.forEach(function(m) {
        if (m.target.classList.contains("dismissed")) {
          body.classList.remove("cover-active");
        }
      });
    }).observe(coverPage, { attributes: true, attributeFilter: ["class"] });
  });
</script>
<script>
(function() {
  const STORAGE_KEY = 'sospc_diagnostic_v1';
  const POS_KEY     = 'sospc_position_v1';
  const DRAG_THRESHOLD = 6;
  const EDGE_MARGIN    = 16;
  const PANEL_W        = 360;

  let isOpen = false;
  let diagData = null, diagReport = null, chatHistory = [];
  let sessionId = null, pollInterval = null;
  let dragStartX = 0, dragStartY = 0;
  let dragOffsetX = 0, dragOffsetY = 0;
  let dragMoved = false, isDragging = false;

  function playPop() {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      [[880,440,0.18,0.25],[1320,660,0.08,0.18]].forEach(([f0,f1,vol,dur]) => {
        const o = ctx.createOscillator(), g = ctx.createGain();
        o.connect(g); g.connect(ctx.destination);
        o.type = 'sine';
        o.frequency.setValueAtTime(f0, ctx.currentTime);
        o.frequency.exponentialRampToValueAtTime(f1, ctx.currentTime + dur * 0.5);
        g.gain.setValueAtTime(0, ctx.currentTime);
        g.gain.linearRampToValueAtTime(vol, ctx.currentTime + 0.01);
        g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);
        o.start(ctx.currentTime); o.stop(ctx.currentTime + dur);
      });
    } catch(e) {}
  }

  function gw() { return document.getElementById('sospc-widget'); }

  function setPos(x, y, snap) {
    const el = gw();
    const rect = el.getBoundingClientRect();
    const ww = window.innerWidth, wh = window.innerHeight;
    x = Math.max(EDGE_MARGIN, Math.min(x, ww - rect.width - EDGE_MARGIN));
    y = Math.max(EDGE_MARGIN, Math.min(y, wh - rect.height - EDGE_MARGIN));
    if (snap) { el.classList.add('sospc-snapping'); setTimeout(() => el.classList.remove('sospc-snapping'), 400); }
    el.style.right = 'auto'; el.style.bottom = 'auto';
    el.style.left = x + 'px'; el.style.top = y + 'px';
    try { localStorage.setItem(POS_KEY, JSON.stringify({x, y})); } catch(e) {}
  }

  function snapToEdge() {
    const el = gw(), r = el.getBoundingClientRect();
    const snapRight = (r.left + r.width / 2) > window.innerWidth / 2;
    const tx = snapRight ? window.innerWidth - r.width - EDGE_MARGIN : EDGE_MARGIN;
    setPos(tx, r.top, true);
  }

  function ensurePanelVisible() {
    const el = gw(), r = el.getBoundingClientRect();
    const ww = window.innerWidth, wh = window.innerHeight;
    const pw = Math.min(PANEL_W, ww - EDGE_MARGIN * 2);
    let x = r.left, y = r.top;
    if (x + pw > ww - EDGE_MARGIN) x = ww - pw - EDGE_MARGIN;
    if (x < EDGE_MARGIN) x = EDGE_MARGIN;
    const ph = Math.min(520, wh * 0.8);
    if (y + ph > wh - EDGE_MARGIN) y = wh - ph - EDGE_MARGIN;
    if (y < EDGE_MARGIN) y = EDGE_MARGIN;
    if (Math.abs(x - r.left) > 1 || Math.abs(y - r.top) > 1) setPos(x, y, true);
  }

  function restorePos() {
    try {
      const s = localStorage.getItem(POS_KEY);
      if (!s) return;
      const {x, y} = JSON.parse(s);
      const el = gw();
      el.style.right = 'auto'; el.style.bottom = 'auto';
      el.style.left = x + 'px'; el.style.top = y + 'px';
    } catch(e) {}
  }

  function initDrag() {
    const handles = [document.getElementById('sospc-fab-content'), document.getElementById('sospc-header')];
    handles.forEach(handle => {
      handle.addEventListener('pointerdown', e => {
        if (e.target.closest('button')) return;
        e.preventDefault();
        handle.setPointerCapture(e.pointerId);
        const r = gw().getBoundingClientRect();
        dragStartX = e.clientX; dragStartY = e.clientY;
        dragOffsetX = e.clientX - r.left; dragOffsetY = e.clientY - r.top;
        dragMoved = false; isDragging = true;
        gw().classList.add('sospc-dragging');
      });
      handle.addEventListener('pointermove', e => {
        if (!isDragging) return;
        if (Math.abs(e.clientX - dragStartX) > DRAG_THRESHOLD || Math.abs(e.clientY - dragStartY) > DRAG_THRESHOLD) dragMoved = true;
        if (!dragMoved) return;
        setPos(e.clientX - dragOffsetX, e.clientY - dragOffsetY, false);
      });
      handle.addEventListener('pointerup', e => {
        if (!isDragging) return;
        isDragging = false;
        gw().classList.remove('sospc-dragging');
        handle.releasePointerCapture(e.pointerId);
        if (dragMoved && !isOpen) snapToEdge();
        if (!dragMoved) setTimeout(() => sospcToggle(), 10);
        dragMoved = false;
      });
      handle.addEventListener('pointercancel', () => { isDragging = false; dragMoved = false; gw().classList.remove('sospc-dragging'); });
    });
  }

  window.sospcToggle = function() {
    const el = gw(); isOpen = !isOpen;
    if (isOpen) {
      el.classList.remove('sospc-closed'); el.classList.add('sospc-open');
      setTimeout(ensurePanelVisible, 50);
      if (!diagData && !pollInterval) startPolling();
      if (diagData) setTimeout(() => { const i = document.getElementById('sospc-input'); if(i) i.focus(); }, 300);
    } else {
      el.classList.remove('sospc-open'); el.classList.add('sospc-closed');
      setTimeout(snapToEdge, 50);
    }
    document.getElementById('sospc-fab-badge').style.display = 'none';
  };

  function save() { try { localStorage.setItem(STORAGE_KEY, JSON.stringify({diagData, diagReport, chatHistory, savedAt: Date.now()})); } catch(e) {} }
  function load() { try { const r = localStorage.getItem(STORAGE_KEY); return r ? JSON.parse(r) : null; } catch(e) { return null; } }
  function clear() { try { localStorage.removeItem(STORAGE_KEY); } catch(e) {} }
  function genId() { return Math.random().toString(36).slice(2,10).toUpperCase(); }
  function buildCmd(sid) { return `$s='${sid}'; irm https://sos-pc.click/diag.ps1 | iex`; }

  window.sospcCopy = function() {
    navigator.clipboard.writeText(document.getElementById('sospc-cmd').textContent).then(() => {
      const btn = document.getElementById('sospc-copy-btn');
      btn.textContent = 'Copié !'; btn.classList.add('copied');
      document.getElementById('sospc-waiting-indicator').style.display = 'flex';
      setTimeout(() => { btn.textContent = 'Copier'; btn.classList.remove('copied'); }, 2500);
    });
  };

  window.sospcReset = function() {
    if (!confirm('Lancer un nouveau scan ?')) return;
    stopPolling(); clear(); sessionStorage.setItem('sospc_reset', '1');
    sessionStorage.setItem('sospc_fresh_session', 'true');
    sessionStorage.setItem('sospc_fresh_session', 'true');
    sessionId = genId();
    document.getElementById('sospc-cmd').textContent = buildCmd(sessionId);
    document.getElementById('sospc-view-diag').style.display = 'none';
    document.getElementById('sospc-view-waiting').style.display = 'block';
    document.getElementById('sospc-waiting-indicator').style.display = 'none';
    document.getElementById('sospc-header-sub').textContent = 'Diagnostic intelligent';
    document.getElementById('sospc-fab-text').textContent = 'Diagnostic PC';
    document.getElementById('sospc-messages').innerHTML = '';
    document.getElementById('sospc-suggestions').innerHTML = '';
    document.getElementById('sospc-attach-bar').style.display = 'none';
    // Notifie index.astro pour retirer la pièce jointe
    window.dispatchEvent(new CustomEvent('sospc:diag-reset'));
    startPolling();
  };

  function startPolling() {
    if (pollInterval) return;
    pollInterval = setInterval(async () => {
      try {
        const r = await fetch(`https://sos-pc-diagnostic.netlify.app/api/poll?s=${sessionId}`);
        const json = await r.json();
        if (json.ready && json.data) {
          stopPolling(); diagData = json.data;
          document.getElementById('sospc-waiting-indicator').style.display = 'none';
          playPop();
          if (!isOpen) { isOpen = true; gw().classList.remove('sospc-closed'); gw().classList.add('sospc-open'); setTimeout(ensurePanelVisible, 50); }
          runAnalysis();
        }
      } catch(e) {}
    }, 2000);
  }
  function stopPolling() { if (pollInterval) { clearInterval(pollInterval); pollInterval = null; } }

  function showDiagView() {
    document.getElementById('sospc-view-waiting').style.display = 'none';
    const v = document.getElementById('sospc-view-diag');
    v.style.display = 'flex'; v.style.flexDirection = 'column';
  }

  function addMsg(role, text) {
    const box = document.getElementById('sospc-messages');
    const div = document.createElement('div');
    div.className = 'sospc-msg ' + role; div.textContent = text;
    box.appendChild(div); box.scrollTop = box.scrollHeight; return div;
  }

  function renderHistory() {
    const box = document.getElementById('sospc-messages'); box.innerHTML = '';
    chatHistory.forEach(m => { const div = document.createElement('div'); div.className = 'sospc-msg ' + (m.role === 'user' ? 'user' : 'bot'); div.textContent = m.content; box.appendChild(div); });
    box.scrollTop = box.scrollHeight;
  }

  function setScore(score) {
    const fill = document.getElementById('sospc-score-fill');
    fill.style.background = score >= 70 ? '#00d4aa' : score >= 40 ? '#e0af68' : '#f7768e';
    document.getElementById('sospc-score-val').textContent = score + '/100';
    setTimeout(() => fill.style.width = score + '%', 100);
  }

  function showSuggestions(items) {
    const wrap = document.getElementById('sospc-suggestions'); wrap.innerHTML = '';
    items.forEach(text => {
      const btn = document.createElement('button'); btn.className = 'sospc-suggestion'; btn.textContent = text;
      btn.onclick = () => { wrap.innerHTML = ''; document.getElementById('sospc-input').value = text; sospcSend(); };
      wrap.appendChild(btn);
    });
  }

  // Construit le rapport texte lisible pour la piece jointe email
  function buildDiagPayload() {
    var d = diagData || {};
    var r = diagReport || {};
    var lines = [];
    var sep  = '';
    var sep2 = '';
    lines.push(sep);
    lines.push('  RAPPORT DIAGNOSTIC SOS-PC');
    lines.push('  ' + new Date().toLocaleString('fr-FR'));
    lines.push(sep);
    lines.push('');
    var score = r.score != null ? r.score : '?';
    var scoreLabel = r.score >= 70 ? 'Bon etat' : r.score >= 40 ? 'Attention requise' : 'Etat critique';
    lines.push('SCORE : ' + score + '/100  -- ' + scoreLabel);
    lines.push('');
    var sec0 = d.security || {};
    if (sec0.defender_enabled === false || sec0.realtime_protection === false) {
      lines.push('/!\\ ALERTE SECURITE /!\\');
      if (sec0.defender_enabled === false)    lines.push('  >> Antivirus Windows Defender INACTIF');
      if (sec0.realtime_protection === false)  lines.push('  >> Protection en temps reel INACTIVE');
      if (sec0.antivirus_signature_date)       lines.push('  >> Dernieres signatures : ' + sec0.antivirus_signature_date);
      lines.push('');
    }
    if (r.summary) { lines.push('RESUME'); lines.push(r.summary); lines.push(''); }
    lines.push(sep2);
    lines.push('SYSTEME');
    lines.push(sep2);
    var os = d.os || {};
    lines.push('OS           : ' + (os.name || os.caption || '?'));
    lines.push('Version      : ' + (os.version || '?') + ' (Build ' + (os.build || '?') + ')');
    lines.push('Architecture : ' + (os.arch || '?'));
    lines.push('Uptime       : ' + (os.uptime || '?') + 'h');
    lines.push('Dernier boot : ' + (os.last_boot || '?'));
    lines.push('');
    var cpu = d.cpu || {};
    lines.push('CPU          : ' + (cpu.name || '?'));
    lines.push('Coeurs       : ' + (cpu.cores || '?') + ' coeurs / ' + (cpu.threads || '?') + ' threads');
    lines.push('Charge       : ' + (cpu.load != null ? cpu.load + '%' : '?'));
    lines.push('');
    lines.push('RAM total    : ' + (os.ram_total_gb || '?') + ' Go');
    var ramUsed = os.ram_total_gb && os.ram_free_gb ? Math.round((1 - os.ram_free_gb / os.ram_total_gb) * 100) : '?';
    lines.push('RAM libre    : ' + (os.ram_free_gb || '?') + ' Go  (' + ramUsed + '% utilisee)');
    if (os.pagefile_total_gb) { lines.push('Pagefile     : ' + os.pagefile_used_gb + ' / ' + os.pagefile_total_gb + ' Go'); }
    lines.push('');
    var gpus = (d.gpus || (d.gpu ? [d.gpu] : [])).filter(Boolean);
    if (gpus.length > 0) {
      lines.push('GPU(S)');
      gpus.forEach(function(g, i) {
        lines.push('  ' + (g.name || '?') + (g.ram_mb ? ' -- ' + g.ram_mb + ' Mo VRAM' : '') + (g.driver ? ' -- driver ' + g.driver : '') + (g.driver_date ? ' (' + g.driver_date + ')' : ''));
        if (g.resolution) lines.push('  Resolution : ' + g.resolution + (g.refresh_hz ? ' @ ' + g.refresh_hz + 'Hz' : ''));
      });
      lines.push('');
    }
    var disks = (d.disks || []).filter(Boolean);
    if (disks.length > 0) {
      lines.push('DISQUES LOGIQUES');
      disks.forEach(function(disk) {
        var pct = disk.pct_used || 0;
        var bar = ''; for (var i = 0; i < 10; i++) bar += i < Math.round(pct/10) ? '#' : '-';
        lines.push('  ' + disk.letter + '  [' + bar + '] ' + pct + '%  --  ' + disk.free_gb + ' Go libres / ' + disk.total_gb + ' Go' + (disk.label ? ' (' + disk.label + ')' : ''));
      });
      lines.push('');
    }
    var physDisks = (d.physical_disks || []).filter(Boolean);
    if (physDisks.length > 0) {
      lines.push('DISQUES PHYSIQUES (SMART)');
      physDisks.forEach(function(pd) {
        lines.push('  ' + pd.friendly_name + ' -- ' + (pd.media_type || '?') + ' / ' + (pd.bus_type || '?') + ' -- ' + pd.size_gb + ' Go');
        lines.push('  Sante : ' + (pd.health_status || '?') + '  |  Heures : ' + (pd.hours_used != null ? pd.hours_used + 'h' : '?') + '  |  Temp : ' + (pd.temperature_c != null ? pd.temperature_c + 'C' : '?'));
        if (pd.reallocated_sectors) lines.push('  ATTENTION : ' + pd.reallocated_sectors + ' secteurs defaillants');
        if (pd.read_errors) lines.push('  ATTENTION : ' + pd.read_errors + ' erreurs de lecture');
      });
      lines.push('');
    }
    var net = d.network || {};
    if (net.adapters && net.adapters.filter(Boolean).length > 0) {
      lines.push('RESEAU');
      lines.push('Internet     : ' + (net.internet_ok ? 'OK' : 'ECHEC') + (net.dns_latency_ms ? '  (DNS: ' + net.dns_latency_ms + 'ms)' : ''));
      net.adapters.filter(Boolean).forEach(function(a) { lines.push('  ' + (a.type || '?') + ' : ' + a.name + (a.ip ? ' -- ' + a.ip : '') + (a.speed_mbps ? ' -- ' + a.speed_mbps + ' Mbps' : '')); });
      lines.push('');
    }
    var sec = d.security || {};
    if (Object.keys(sec).length > 0) {
      lines.push('SECURITE');
      lines.push('Antivirus    : ' + (sec.defender_enabled ? 'Actif' : 'INACTIF') + '  |  Temps reel : ' + (sec.realtime_protection ? 'Actif' : 'INACTIF'));
      if (sec.antivirus_signature_date) lines.push('Signatures   : ' + sec.antivirus_signature_date);
      lines.push('Pare-feu     : Domaine ' + (sec.firewall_domain ? 'OK' : 'OFF') + ' / Prive ' + (sec.firewall_private ? 'OK' : 'OFF') + ' / Public ' + (sec.firewall_public ? 'OK' : 'OFF'));
      lines.push('UAC          : ' + (sec.uac_enabled ? 'Actif' : 'Inactif'));
      lines.push('');
    }
    var temps = (d.temperatures || []).filter(Boolean);
    if (temps.length > 0) {
      lines.push('TEMPERATURES');
      temps.forEach(function(t) { lines.push('  ' + t.instance + ' : ' + t.temp_celsius + 'C'); });
      lines.push('');
    }
    var perf = d.performance || {};
    if (Object.keys(perf).length > 0) {
      lines.push('PERFORMANCE');
      if (perf.disk_pct_busy != null) lines.push('Disque I/O   : ' + perf.disk_pct_busy + '%');
      if (perf.ram_used_pct != null)  lines.push('RAM          : ' + perf.ram_used_pct + '%');
      if (perf.pagefile_used_pct != null) lines.push('Pagefile     : ' + perf.pagefile_used_pct + '%');
      lines.push('');
    }
    var stab = d.stability || {};
    if (stab.bsod_count > 0) {
      lines.push(sep2);
      lines.push('CRASHS SYSTEME 7 JOURS : ' + stab.bsod_count);
      lines.push(sep2);
      (stab.bsod_last_7days || []).forEach(function(b) { lines.push('  [' + b.time + '] ID:' + b.id + ' -- ' + b.message); });
      lines.push('');
    }
    var issues = r.issues || [];
    if (issues.length > 0) {
      lines.push(sep2);
      lines.push('PROBLEMES DETECTES (' + issues.length + ')');
      lines.push(sep2);
      issues.forEach(function(issue) {
        var lvl = issue.level === 'critical' ? '[CRITIQUE] ' : issue.level === 'warning' ? '[ATTENTION]' : '[OK]       ';
        lines.push(lvl + ' ' + (issue.category ? '[' + issue.category + '] ' : '') + issue.title);
        if (issue.description) lines.push('           ' + issue.description);
        if (issue.action)      lines.push('           Action : ' + issue.action);
        lines.push('');
      });
    }
    var qw = r.quick_wins || [];
    if (qw.length > 0) {
      lines.push('ACTIONS RAPIDES');
      qw.forEach(function(w, i) { lines.push('  ' + (i+1) + '. ' + w); });
      lines.push('');
    }
    var symptoms = chatHistory.filter(function(m) { return m.role === 'user'; }).map(function(m) { return m.content; });
    if (symptoms.length > 0) {
      lines.push(sep2);
      lines.push('SYMPTOMES DECRITS PAR L\'UTILISATEUR');
      lines.push(sep2);
      symptoms.forEach(function(s, i) { lines.push('  ' + (i+1) + '. "' + s + '"'); });
      lines.push('');
    }
    var startup = (d.startup || []).filter(Boolean);
    if (startup.length > 0) {
      lines.push('DEMARRAGE AUTOMATIQUE (' + startup.length + ' programmes)');
      startup.forEach(function(s) { lines.push('  - ' + s); });
      lines.push('');
    }
    var updates = ((d.updates || {}).last_hotfixes || []).filter(Boolean);
    if (updates.length > 0) {
      lines.push('DERNIERES MISES A JOUR');
      updates.forEach(function(u) { lines.push('  ' + u.id + ' -- ' + u.description + ' (' + u.installed_on + ')'); });
      lines.push('');
    }
    var procs = (d.procs || []).filter(Boolean);
    if (procs.length > 0) {
      lines.push('TOP PROCESSUS (RAM)');
      procs.forEach(function(p) { lines.push('  ' + p.name + ' -- ' + p.ram_mb + ' Mo'); });
      lines.push('');
    }
    var software = (d.software || []).filter(Boolean);
    if (software.length > 0) {
      lines.push(sep2);
      lines.push('LOGICIELS INSTALLES (' + software.length + ')');
      lines.push(sep2);
      software.forEach(function(s) {
        var line = '  ' + s.name;
        if (s.version)      line += '  v' + s.version;
        if (s.publisher)    line += '  (' + s.publisher + ')';
        if (s.install_date) line += '  -- ' + s.install_date;
        lines.push(line);
      });
      lines.push('');
    }
    lines.push(sep);
    lines.push('  Rapport SOS-PC -- sos-pc.click -- ' + new Date().toLocaleString('fr-FR'));
    lines.push(sep);
    return {
      text: lines.join('\n'),
      generated: new Date().toLocaleString('fr-FR'),
      score: r.score,
      issues: r.issues || [],
      symptoms_user: symptoms
    };
  }

  // Bouton "Joindre au formulaire"
  window.sospcAttachToForm = function() {
    const payload = buildDiagPayload();
    // Envoie à index.astro via event
    window.dispatchEvent(new CustomEvent('sospc:attach-diag', { detail: payload }));
    // Scroll vers #contact
    const section = document.getElementById('contact');
    if (section) section.scrollIntoView({ behavior: 'smooth' });
    // Feedback visuel sur le bouton
    const btn = document.getElementById('sospc-attach-btn');
    if (btn) {
      btn.classList.add('attached');
      btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Diagnostic joint !';
      setTimeout(() => {
        btn.classList.remove('attached');
        btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg> Joindre au formulaire de contact';
      }, 2500);
    }
  };

  function runAnalysis() {
    showDiagView();
    document.getElementById('sospc-header-sub').textContent = 'Analyse en cours...';
    const typing = addMsg('bot typing', '> analyse en cours...');
    fetch('https://sos-pc-diagnostic.netlify.app/api/analyze', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({data: diagData, problem: ''}) })
    .then(r => r.json())
    .then(json => {
      diagReport = json.report; typing.remove();
      setScore(diagReport?.score || 50);
      document.getElementById('sospc-header-sub').textContent = 'Diagnostic terminé';
      document.getElementById('sospc-fab-text').textContent = 'Voir le diagnostic';
      const summary = diagReport?.summary || 'Analyse terminée.';
      addMsg('bot', summary); chatHistory.push({role:'assistant', content: summary});
      const crits = (diagReport?.issues||[]).filter(i => i.level==='critical');
      if (crits.length) { const msg = '⚠ ' + crits.length + ' problème(s) critique(s) : ' + crits.map(i=>i.title).join(', ') + '.'; addMsg('bot', msg); chatHistory.push({role:'assistant', content: msg}); }
      if ((diagReport?.issues||[]).some(i => i.level !== 'ok')) { const cta = 'Nos techniciens peuvent résoudre ces problèmes. Voulez-vous être contacté ?'; addMsg('bot', cta); chatHistory.push({role:'assistant', content: cta}); }
      showSuggestions(['Expliquer le problème', 'Améliorer les perfs', 'Contacter SOS-PC']);
      save();
      // Montre le bouton joindre + auto-attache au form
      document.getElementById('sospc-attach-bar').style.display = 'block';
      window.dispatchEvent(new CustomEvent('sospc:attach-diag', { detail: buildDiagPayload() }));
    })
    .catch(() => { typing.remove(); addMsg('bot', 'Erreur d\'analyse. Contactez-nous au 07 69 56 14 91.'); });
  }

  window.sospcSend = function() {
    const input = document.getElementById('sospc-input');
    const msg = input.value.trim(); if (!msg) return;
    input.value = ''; document.getElementById('sospc-send').disabled = true;
    document.getElementById('sospc-suggestions').innerHTML = '';
    addMsg('user', msg); chatHistory.push({role:'user', content: msg});
    const typing = addMsg('bot typing', '...');
    fetch('https://sos-pc-diagnostic.netlify.app/api/chat', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({messages: chatHistory, systemData: diagData, report: diagReport}) })
    .then(r => r.json())
    .then(json => {
      typing.remove(); const reply = json.message || 'Erreur.';
      addMsg('bot', reply); chatHistory.push({role:'assistant', content: reply});
      // Met à jour la pièce jointe avec les nouveaux symptômes du chat
      save();
      window.dispatchEvent(new CustomEvent('sospc:attach-diag-update', { detail: buildDiagPayload() }));
    })
    .catch(() => { typing.remove(); addMsg('bot', 'Erreur de connexion.'); })
    .finally(() => { document.getElementById('sospc-send').disabled = false; input.focus(); });
  };

  document.addEventListener('DOMContentLoaded', function() {
    initDrag(); restorePos();
    const saved = load();
    if (saved && saved.diagData && !sessionStorage.getItem('sospc_reset')) {
      diagData = saved.diagData; diagReport = saved.diagReport; chatHistory = saved.chatHistory || [];
      showDiagView();
      if (diagReport) setScore(diagReport.score || 50);
      renderHistory();
      if (diagReport) {
        showSuggestions(['Rappelle-moi le résumé', 'Améliorer les perfs', 'Contacter SOS-PC']);
        document.getElementById('sospc-attach-bar').style.display = 'block';
      }
      document.getElementById('sospc-header-sub').textContent = 'Diagnostic sauvegardé';
      document.getElementById('sospc-fab-text').textContent = 'Voir le diagnostic';
      document.getElementById('sospc-fab-badge').style.display = 'flex';
    } else {
      sessionStorage.removeItem('sospc_reset');
      sessionId = genId();
      document.getElementById('sospc-cmd').textContent = buildCmd(sessionId);
    }
  });
})();
</script>
