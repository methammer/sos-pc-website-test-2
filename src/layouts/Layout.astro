		.sospc-msg.typing { opacity: 0.6; font-style: italic; }

		/* Suggestions */
		#sospc-suggestions {
			display: flex;
			flex-wrap: wrap;
			gap: 6px;
			padding: 0 12px 10px;
		}
		.sospc-suggestion {
			background: rgba(var(--accent), 0.1);
			color: rgb(var(--accent-dark));
			border: 1px solid rgba(var(--accent), 0.25);
			border-radius: 20px;
			padding: 5px 12px;
			font-size: 12px;
			cursor: pointer;
			transition: background 0.2s;
			white-space: nowrap;
		}
		.sospc-suggestion:hover { background: rgba(var(--accent), 0.2); }

		/* Input */
		#sospc-input-wrap {
			display: flex;
			gap: 8px;
			padding: 10px 12px;
			border-top: 1px solid var(--border-color);
			flex-shrink: 0;
		}
		#sospc-input {
			flex: 1;
			background: var(--bg-color);
			border: 1px solid var(--border-color);
			border-radius: 20px;
			padding: 8px 14px;
			font-size: 13px;
			color: var(--text-color);
			outline: none;
			transition: border 0.2s;
		}
		#sospc-input:focus { border-color: rgb(var(--accent)); }
		#sospc-send {
			background: rgb(var(--accent));
			color: white;
			border: none;
			border-radius: 50%;
			width: 34px;
			height: 34px;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			transition: background 0.2s, transform 0.1s;
		}
		#sospc-send:hover { background: rgb(var(--accent-dark)); }
		#sospc-send:active { transform: scale(0.95); }
		#sospc-send:disabled { background: var(--border-color); cursor: default; }

		@media (max-width: 480px) {
			#sospc-panel { width: calc(100vw - 32px); }
			#sospc-widget { bottom: 16px; right: 16px; }
			#sospc-fab-text { display: none; }
			#sospc-fab { padding: 14px; border-radius: 50%; }
		}
		</style>

		<script>
		(function() {
			let panelOpen = false;
			let diagData = null;
			let diagReport = null;
			const history = [];

			// Toggle panel
			window.sospcToggle = function() {
				panelOpen = !panelOpen;
				const panel = document.getElementById('sospc-panel');
				panel.classList.toggle('open', panelOpen);
				document.getElementById('sospc-fab-badge').style.display = 'none';
				if (panelOpen && diagData && !diagReport) {
					sospcAnalyze();
				}
				if (panelOpen && diagData) {
					setTimeout(() => {
						const input = document.getElementById('sospc-input');
						if (input) input.focus();
					}, 200);
				}
			};

			// Copier commande
			window.sospcCopy = function() {
				const cmd = document.getElementById('sospc-cmd').textContent;
				navigator.clipboard.writeText(cmd).then(() => {
					const btn = document.getElementById('sospc-copy-btn');
					btn.textContent = 'Copié !';
					btn.classList.add('copied');
					setTimeout(() => { btn.textContent = 'Copier'; btn.classList.remove('copied'); }, 2500);
				});
			};

			// Ajouter un message
			function addMsg(role, text) {
				const box = document.getElementById('sospc-messages');
				const div = document.createElement('div');
				div.className = 'sospc-msg ' + role;
				div.textContent = text;
				box.appendChild(div);
				box.scrollTop = box.scrollHeight;
				return div;
			}

			// Suggestions rapides
			function showSuggestions(items) {
				const wrap = document.getElementById('sospc-suggestions');
				wrap.innerHTML = '';
				items.forEach(text => {
					const btn = document.createElement('button');
					btn.className = 'sospc-suggestion';
					btn.textContent = text;
					btn.onclick = () => {
						wrap.innerHTML = '';
						document.getElementById('sospc-input').value = text;
						sospcSend();
					};
					wrap.appendChild(btn);
				});
			}

			// Envoyer un message
			window.sospcSend = function() {
				const input = document.getElementById('sospc-input');
				const msg = input.value.trim();
				if (!msg) return;
				input.value = '';
				document.getElementById('sospc-send').disabled = true;
				document.getElementById('sospc-suggestions').innerHTML = '';

				addMsg('user', msg);
				history.push({ role: 'user', content: msg });

				const typing = addMsg('bot typing', '...');

				fetch('https://sos-pc-diagnostic.netlify.app/api/chat', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ messages: history, systemData: diagData, report: diagReport })
				})
				.then(r => r.json())
				.then(json => {
					typing.remove();
					const reply = json.message || 'Désolé, une erreur est survenue.';
					addMsg('bot', reply);
					history.push({ role: 'assistant', content: reply });
				})
				.catch(() => {
					typing.remove();
					addMsg('bot', 'Erreur de connexion. Veuillez réessayer.');
				})
				.finally(() => {
					document.getElementById('sospc-send').disabled = false;
					input.focus();
				});
			};

			// Analyser avec l'IA
			function sospcAnalyze() {
				const typing = addMsg('bot typing', 'Analyse de votre PC en cours...');

				fetch('https://sos-pc-diagnostic.netlify.app/api/analyze', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ data: diagData, problem: '' })
				})
				.then(r => r.json())
				.then(json => {
					diagReport = json.report;
					typing.remove();

					// Score
					const score = diagReport?.score || 50;
					const fill = document.getElementById('sospc-score-fill');
					fill.style.background = score >= 70 ? '#1D9E75' : score >= 40 ? '#BA7517' : '#E24B4A';
					document.getElementById('sospc-score-val').textContent = score + '/100';
					setTimeout(() => fill.style.width = score + '%', 100);

					// Résumé
					const summary = diagReport?.summary || 'Analyse terminée.';
					addMsg('bot', summary);
					history.push({ role: 'assistant', content: summary });

					// Problèmes critiques
					const crits = (diagReport?.issues || []).filter(i => i.level === 'critical');
					if (crits.length) {
						const msg = '⚠️ ' + crits.length + ' problème(s) critique(s) : ' + crits.map(i => i.title).join(', ') + '.';
						addMsg('bot', msg);
						history.push({ role: 'assistant', content: msg });
					}

					// Suggestions
					showSuggestions(['Expliquer le problème principal', 'Comment améliorer les performances ?', 'Contacter SOS-PC']);
				})
				.catch(() => {
					typing.remove();
					addMsg('bot', 'Erreur lors de l\'analyse. Contactez-nous directement.');
				});
			}

			// Init au chargement
			document.addEventListener('DOMContentLoaded', function() {
				const params = new URLSearchParams(window.location.search);
				const encoded = params.get('diag');

				if (encoded) {
					// Nettoyer l'URL
					window.history.replaceState({}, '', window.location.pathname + window.location.hash);

					try { diagData = JSON.parse(atob(encoded)); } catch { return; }

					// Passer en vue diagnostic
					document.getElementById('sospc-view-intro').style.display = 'none';
					document.getElementById('sospc-view-diag').style.display = 'flex';
					document.getElementById('sospc-view-diag').style.flexDirection = 'column';
					document.getElementById('sospc-header-sub').textContent = 'Analyse en cours...';

					// Badge + ouvrir automatiquement
					document.getElementById('sospc-fab-badge').style.display = 'flex';
					document.getElementById('sospc-fab-text').textContent = 'Voir le diagnostic';

					// Ouvrir le panel et lancer l'analyse
					panelOpen = true;
					document.getElementById('sospc-panel').classList.add('open');

					// Scroll vers section diagnostic
					const section = document.getElementById('diagnostic');
					if (section) section.scrollIntoView({ behavior: 'smooth', block: 'center' });

					sospcAnalyze();

					// Header mis à jour après analyse
					setTimeout(() => {
						document.getElementById('sospc-header-sub').textContent = 'Diagnostic terminé';
					}, 4000);
				}
			});
		})();
		</script>

</body>
