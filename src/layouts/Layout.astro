---
import Navbar from '../components/Navbar.astro';
import AsciiBackground from '../components/AsciiBackground.astro';
import CoverPage from '../components/CoverPage.astro'; // Import the CoverPage component

interface Props {
	title: string;
	description?: string;
}

const { title, description = "SOS-PC - Solutions informatiques et web" } = Astro.props;
const maxNavbarHeight = "80px"; // Adjusted navbar height
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/logo.png" /> {/* Updated favicon path */}
		<meta name="generator" content={Astro.generator} />
		<title>{title} | SOS-PC</title>
		{/* Add Open Graph og:image meta tag if not already present, or update existing one */}
		<meta property="og:image" content="/logo.png" /> {/* Updated OG image path */}
		<style define:vars={{ maxNavbarHeight }}>
			html {
				scroll-padding-top: var(--maxNavbarHeight);
				scroll-behavior: smooth;
			}
      /* Prevent scroll on body while cover page is active */
      body.cover-active {
        overflow: hidden;
        /* On some systems, scrollbar might still be there, taking space.
           This is a common issue. For a perfect solution, more complex JS might be needed
           to calculate scrollbar width and add padding, or use position:fixed on body.
           For now, overflow:hidden is the simplest approach. */
      }
		</style>
		{/* Inline script to set initial theme to prevent FOUC (Flash of Unstyled Content) */}
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark'); // Ensure light is default if no class
			}
		</script>
	</head>
	<body>
    <CoverPage /> {/* Add CoverPage here, it will control its own visibility */}
    <AsciiBackground />
		<Navbar />
		<main tabindex="-1"> {/* Added tabindex for programmatic focus */}
			<slot />
		</main>
		<footer>
			<p>&copy; {new Date().getFullYear()} SOS-PC. Tous droits réservés.</p>
		</footer>
    <script>
      // Script to add/remove 'cover-active' class on body based on CoverPage state
      document.addEventListener('DOMContentLoaded', () => {
        const coverPage = document.getElementById('sos-pc-cover-page'); // ID from CoverPage.astro
        const body = document.body;
        const dismissedKey = 'sospc_cover_dismissed_session_v1'; // Must match key in CoverPage.astro

        if (!coverPage) return;

        function updateBodyScrollState() {
          let isCoverDismissedBySession = false;
          try {
            isCoverDismissedBySession = sessionStorage.getItem(dismissedKey) === 'true';
          } catch(e) { /* ignore */ }

          // If coverPage has 'dismissed' class OR if it was dismissed in session (and might be hidden by its own script)
          if (coverPage.classList.contains('dismissed') || isCoverDismissedBySession) {
            body.classList.remove('cover-active');
          } else {
            body.classList.add('cover-active');
          }
        }

        updateBodyScrollState(); // Set initial state

        // Observe CoverPage for class changes (when it gets 'dismissed')
        const observer = new MutationObserver((mutationsList) => {
          for (const mutation of mutationsList) {
            if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
              updateBodyScrollState();
              // If cover is now dismissed, we can stop observing
              if (coverPage.classList.contains('dismissed')) {
                observer.disconnect();
              }
              break; // Only need to check one mutation if class attribute changed
            }
          }
        });
        
        // Only start observing if the cover page is not already dismissed by session logic
        // (The CoverPage.astro script handles adding 'dismissed' class if session key is found)
        if (!coverPage.classList.contains('dismissed')) {
            observer.observe(coverPage, { attributes: true, attributeFilter: ['class'] });
        }
      });
    </script>
	
		<!-- ===== CHATBOT FLOTTANT ===== -->
		<div id="diag-chatbot" style="display:none;">
			<div id="diag-chat-bubble" onclick="toggleChat()">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
				<span id="diag-chat-label">Diagnostic prêt</span>
				<span id="diag-chat-notif">1</span>
			</div>

			<div id="diag-chat-panel">
				<div id="diag-chat-header">
					<div>
						<strong>Assistant SOS-PC</strong>
						<span id="diag-chat-status">Analyse terminée</span>
					</div>
					<button onclick="toggleChat()" id="diag-chat-close">✕</button>
				</div>

				<div id="diag-chat-score-bar">
					<span id="diag-score-label">Score santé</span>
					<div id="diag-score-track"><div id="diag-score-fill"></div></div>
					<span id="diag-score-val">—</span>
				</div>

				<div id="diag-chat-messages"></div>

				<div id="diag-chat-input-row">
					<input type="text" id="diag-chat-input" placeholder="Posez une question..." onkeydown="if(event.key==='Enter') sendDiagChat()" />
					<button onclick="sendDiagChat()" id="diag-chat-send">↑</button>
				</div>
			</div>
		</div>

		<style>
			/* ===== SECTION DIAGNOSTIC ===== */
			.diagnostic-section { text-align: center; }
			.diagnostic-intro { color: var(--text-secondary, #666); max-width: 540px; margin: 0 auto 2rem; }

			.diagnostic-card {
				background: var(--card-bg, white);
				border: 1px solid var(--border-color, #e8e7e4);
				border-radius: 12px;
				padding: 2rem;
				max-width: 600px;
				margin: 0 auto;
				text-align: left;
			}

			.diagnostic-steps { display: flex; flex-direction: column; gap: 12px; margin-bottom: 1.5rem; }
			.diag-step { display: flex; align-items: flex-start; gap: 12px; font-size: 14px; }
			.diag-step-num {
				width: 26px; height: 26px; border-radius: 50%;
				background: #185FA5; color: white;
				font-size: 12px; font-weight: 600;
				display: flex; align-items: center; justify-content: center; flex-shrink: 0;
			}
			.diag-step kbd {
				background: #f4f4f2; border: 1px solid #d0d0cc;
				border-radius: 4px; padding: 1px 6px; font-size: 12px; font-family: inherit;
			}

			.diag-cmd-box {
				background: #1e1e1e; border-radius: 8px;
				padding: 1rem 1.25rem;
				display: flex; align-items: center; justify-content: space-between; gap: 12px;
				margin-bottom: 1rem;
			}
			.diag-cmd-box code { color: #4ec9b0; font-size: 13px; font-family: 'Courier New', monospace; word-break: break-all; }
			.diag-copy-btn {
				background: #333; color: #ccc; border: none; border-radius: 6px;
				padding: 6px 14px; font-size: 13px; cursor: pointer; flex-shrink: 0; transition: background 0.2s;
			}
			.diag-copy-btn:hover { background: #555; }
			.diag-copy-btn.copied { background: #1D9E75; color: white; }
			.diag-privacy { font-size: 12px; color: #888; text-align: center; }

			/* ===== CHATBOT FLOTTANT ===== */
			#diag-chatbot { position: fixed; bottom: 24px; right: 24px; z-index: 9999; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

			#diag-chat-bubble {
				background: #185FA5; color: white;
				border-radius: 50px; padding: 12px 20px;
				display: flex; align-items: center; gap: 10px;
				cursor: pointer; box-shadow: 0 4px 20px rgba(24,95,165,0.4);
				transition: transform 0.2s, box-shadow 0.2s;
			}
			#diag-chat-bubble:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(24,95,165,0.5); }
			#diag-chat-label { font-size: 14px; font-weight: 500; }
			#diag-chat-notif {
				background: #E24B4A; color: white; border-radius: 50%;
				width: 18px; height: 18px; font-size: 11px; font-weight: 700;
				display: flex; align-items: center; justify-content: center;
			}

			#diag-chat-panel {
				position: absolute; bottom: 60px; right: 0;
				width: 360px; background: white;
				border: 1px solid #e8e7e4; border-radius: 16px;
				box-shadow: 0 8px 40px rgba(0,0,0,0.15);
				display: none; flex-direction: column; overflow: hidden;
			}
			#diag-chat-panel.open { display: flex; }

			#diag-chat-header {
				background: #185FA5; color: white;
				padding: 14px 16px;
				display: flex; justify-content: space-between; align-items: center;
			}
			#diag-chat-header strong { font-size: 14px; display: block; }
			#diag-chat-status { font-size: 11px; opacity: 0.8; }
			#diag-chat-close { background: none; border: none; color: white; font-size: 16px; cursor: pointer; opacity: 0.7; padding: 0; }
			#diag-chat-close:hover { opacity: 1; }

			#diag-chat-score-bar {
				display: flex; align-items: center; gap: 10px;
				padding: 10px 16px; background: #f4f4f2; border-bottom: 1px solid #e8e7e4;
				font-size: 12px;
			}
			#diag-score-label { color: #666; flex-shrink: 0; }
			#diag-score-track { flex: 1; height: 6px; background: #e0e0e0; border-radius: 3px; overflow: hidden; }
			#diag-score-fill { height: 100%; border-radius: 3px; width: 0%; transition: width 1s ease; }
			#diag-score-val { font-weight: 600; font-size: 13px; flex-shrink: 0; min-width: 36px; text-align: right; }

			#diag-chat-messages {
				flex: 1; overflow-y: auto; padding: 14px;
				display: flex; flex-direction: column; gap: 10px;
				max-height: 300px; min-height: 120px;
			}
			.diag-msg { max-width: 85%; padding: 9px 13px; border-radius: 10px; font-size: 13px; line-height: 1.5; }
			.diag-msg.user { background: #185FA5; color: white; align-self: flex-end; border-bottom-right-radius: 3px; }
			.diag-msg.bot { background: #f4f4f2; color: #1a1a18; align-self: flex-start; border-bottom-left-radius: 3px; }
			.diag-msg.typing { color: #999; font-style: italic; }

			#diag-chat-input-row { display: flex; gap: 8px; padding: 12px; border-top: 1px solid #e8e7e4; }
			#diag-chat-input {
				flex: 1; border: 1px solid #e8e7e4; border-radius: 20px;
				padding: 8px 14px; font-size: 13px; outline: none; transition: border 0.2s;
			}
			#diag-chat-input:focus { border-color: #378ADD; }
			#diag-chat-send {
				background: #185FA5; color: white; border: none;
				border-radius: 50%; width: 34px; height: 34px;
				font-size: 16px; cursor: pointer; flex-shrink: 0;
				display: flex; align-items: center; justify-content: center;
			}
			#diag-chat-send:disabled { background: #e0e0e0; }

			@media (max-width: 480px) {
				#diag-chat-panel { width: calc(100vw - 32px); right: -8px; }
				#diag-chatbot { bottom: 16px; right: 16px; }
			}
		</style>

		<script>
			// ===== SECTION DIAGNOSTIC =====
			function copyDiagCmd() {
				const cmd = document.getElementById('diag-cmd').textContent;
				navigator.clipboard.writeText(cmd).then(() => {
					const btn = document.querySelector('.diag-copy-btn');
					btn.textContent = 'Copié !';
					btn.classList.add('copied');
					setTimeout(() => { btn.textContent = 'Copier'; btn.classList.remove('copied'); }, 2500);
				});
			}

			// ===== CHATBOT =====
			let diagData = null;
			let diagReport = null;
			const diagHistory = [];
			let chatOpen = false;

			function toggleChat() {
				chatOpen = !chatOpen;
				const panel = document.getElementById('diag-chat-panel');
				const notif = document.getElementById('diag-chat-notif');
				panel.classList.toggle('open', chatOpen);
				if (chatOpen) notif.style.display = 'none';
			}

			function diagAppendMsg(role, text) {
				const box = document.getElementById('diag-chat-messages');
				const div = document.createElement('div');
				div.className = 'diag-msg ' + role;
				div.textContent = text;
				box.appendChild(div);
				box.scrollTop = box.scrollHeight;
				return div;
			}

			async function sendDiagChat() {
				const input = document.getElementById('diag-chat-input');
				const msg = input.value.trim();
				if (!msg) return;
				input.value = '';
				document.getElementById('diag-chat-send').disabled = true;

				diagAppendMsg('user', msg);
				diagHistory.push({ role: 'user', content: msg });

				const typing = diagAppendMsg('bot typing', '...');

				try {
					const resp = await fetch('https://sos-pc-diagnostic.netlify.app/api/chat', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ messages: diagHistory, systemData: diagData, report: diagReport })
					});
					const json = await resp.json();
					const reply = json.message || 'Désolé, une erreur est survenue.';
					typing.remove();
					diagAppendMsg('bot', reply);
					diagHistory.push({ role: 'assistant', content: reply });
				} catch {
					typing.remove();
					diagAppendMsg('bot', 'Erreur de connexion. Veuillez réessayer.');
				} finally {
					document.getElementById('diag-chat-send').disabled = false;
					input.focus();
				}
			}

			// ===== INIT : lecture des données URL =====
			(async function initDiag() {
				const params = new URLSearchParams(window.location.search);
				const encoded = params.get('diag');
				if (!encoded) return;

				// Nettoyer l'URL sans recharger
				window.history.replaceState({}, '', window.location.pathname);

				try {
					diagData = JSON.parse(atob(encoded));
				} catch { return; }

				// Afficher le chatbot
				document.getElementById('diag-chatbot').style.display = 'block';

				// Analyser avec l'IA
				const typing = diagAppendMsg('bot typing', 'Analyse de votre PC en cours...');

				try {
					const resp = await fetch('https://sos-pc-diagnostic.netlify.app/api/analyze', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ data: diagData, problem: '' })
					});
					const json = await resp.json();
					diagReport = json.report;

					typing.remove();

					// Score
					const score = diagReport?.score || 50;
					const fill = document.getElementById('diag-score-fill');
					fill.style.background = score >= 70 ? '#1D9E75' : score >= 40 ? '#BA7517' : '#E24B4A';
					document.getElementById('diag-score-val').textContent = score + '/100';
					setTimeout(() => { fill.style.width = score + '%'; }, 200);

					// Message d'accueil avec résumé
					const summary = diagReport?.summary || 'Analyse terminée.';
					diagAppendMsg('bot', summary);
					diagHistory.push({ role: 'assistant', content: summary });

					// Problèmes critiques en premier
					const criticals = (diagReport?.issues || []).filter(i => i.level === 'critical');
					if (criticals.length) {
						const msg = `⚠️ ${criticals.length} problème(s) critique(s) détecté(s) : ${criticals.map(i => i.title).join(', ')}. Voulez-vous que je vous explique ?`;
						diagAppendMsg('bot', msg);
						diagHistory.push({ role: 'assistant', content: msg });
					}

					// Ouvrir automatiquement
					toggleChat();

					// Scroll vers section diagnostic
					document.getElementById('diagnostic')?.scrollIntoView({ behavior: 'smooth', block: 'center' });

				} catch {
					typing.remove();
					diagAppendMsg('bot', 'Une erreur est survenue lors de l\'analyse. Contactez-nous directement.');
					toggleChat();
				}
			})();
		</script>


		<!-- ===== SOS-PC ASSISTANT FLOTTANT ===== -->
		<div id="sospc-widget">

			<!-- Bouton flottant toujours visible -->
			<button id="sospc-fab" onclick="sospcToggle()" aria-label="Assistant SOS-PC">
				<span id="sospc-fab-icon">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
				</span>
				<span id="sospc-fab-text">Diagnostic PC</span>
				<span id="sospc-fab-badge" style="display:none">!</span>
			</button>

			<!-- Panneau principal -->
			<div id="sospc-panel">

				<!-- Header -->
				<div id="sospc-header">
					<div id="sospc-header-info">
						<span id="sospc-header-title">Assistant SOS-PC</span>
						<span id="sospc-header-sub">Diagnostic intelligent</span>
					</div>
					<button id="sospc-close" onclick="sospcToggle()" aria-label="Fermer">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
					</button>
				</div>

				<!-- Vue AVANT diagnostic -->
				<div id="sospc-view-intro">
					<div id="sospc-intro-body">
						<p id="sospc-intro-title">Analysez votre PC gratuitement</p>
						<p id="sospc-intro-desc">Notre IA détecte les problèmes de performance, les erreurs système et vous donne des conseils personnalisés.</p>

						<div id="sospc-steps">
							<div class="sospc-step">
								<span class="sospc-step-n">1</span>
								<span>Ouvrez le Terminal (<kbd>Win</kbd>+<kbd>X</kbd> → Terminal)</span>
							</div>
							<div class="sospc-step">
								<span class="sospc-step-n">2</span>
								<span>Copiez et collez cette commande :</span>
							</div>
						</div>

						<div id="sospc-cmd-box">
							<code id="sospc-cmd">irm https://sos-pc.click/diag.ps1 | iex</code>
							<button id="sospc-copy-btn" onclick="sospcCopy()">Copier</button>
						</div>

						<div class="sospc-step" style="margin-top:8px">
							<span class="sospc-step-n">3</span>
							<span>La page se recharge automatiquement avec votre diagnostic</span>
						</div>

						<p id="sospc-privacy">🔒 Aucun fichier personnel collecté — uniquement les données techniques.</p>
					</div>
				</div>

				<!-- Vue APRÈS diagnostic -->
				<div id="sospc-view-diag" style="display:none">

					<!-- Score -->
					<div id="sospc-score-wrap">
						<span id="sospc-score-lbl">Santé du PC</span>
						<div id="sospc-score-track"><div id="sospc-score-fill"></div></div>
						<span id="sospc-score-val">—</span>
					</div>

					<!-- Messages chat -->
					<div id="sospc-messages"></div>

					<!-- Suggestions rapides -->
					<div id="sospc-suggestions"></div>

					<!-- Input -->
					<div id="sospc-input-wrap">
						<input id="sospc-input" type="text" placeholder="Posez une question..." onkeydown="if(event.key==='Enter')sospcSend()" />
						<button id="sospc-send" onclick="sospcSend()">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
						</button>
					</div>
				</div>

			</div>
		</div>

		<style>
		#sospc-widget {
			position: fixed;
			bottom: 24px;
			right: 24px;
			z-index: 9999;
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			gap: 12px;
			font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		}

		/* FAB */
		#sospc-fab {
			display: flex;
			align-items: center;
			gap: 8px;
			background: rgb(var(--accent));
			color: white;
			border: none;
			border-radius: 50px;
			padding: 12px 20px;
			font-size: 14px;
			font-weight: 600;
			cursor: pointer;
			box-shadow: 0 4px 16px rgba(136,58,234,0.4);
			transition: transform 0.2s, box-shadow 0.2s;
			white-space: nowrap;
		}
		#sospc-fab:hover {
			transform: translateY(-2px);
			box-shadow: 0 6px 24px rgba(136,58,234,0.5);
		}
		#sospc-fab-badge {
			background: #E24B4A;
			color: white;
			border-radius: 50%;
			width: 18px;
			height: 18px;
			font-size: 11px;
			font-weight: 700;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		/* Panneau */
		#sospc-panel {
			width: 360px;
			background: var(--card-bg-color);
			border: 1px solid var(--border-color);
			border-radius: 16px;
			box-shadow: 0 8px 40px rgba(0,0,0,0.18);
			display: none;
			flex-direction: column;
			overflow: hidden;
			max-height: 80vh;
		}
		#sospc-panel.open {
			display: flex;
		}

		/* Header */
		#sospc-header {
			background: rgb(var(--accent));
			padding: 14px 16px;
			display: flex;
			justify-content: space-between;
			align-items: center;
			flex-shrink: 0;
		}
		#sospc-header-title {
			display: block;
			color: white;
			font-size: 14px;
			font-weight: 600;
		}
		#sospc-header-sub {
			display: block;
			color: rgba(255,255,255,0.75);
			font-size: 11px;
		}
		#sospc-close {
			background: none;
			border: none;
			color: white;
			cursor: pointer;
			opacity: 0.75;
			padding: 4px;
			border-radius: 6px;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: opacity 0.2s, background 0.2s;
		}
		#sospc-close:hover { opacity: 1; background: rgba(255,255,255,0.15); }

		/* Vue intro */
		#sospc-intro-body {
			padding: 16px;
			overflow-y: auto;
		}
		#sospc-intro-title {
			font-size: 15px;
			font-weight: 600;
			color: var(--heading-color);
