<script>
  // ===== LOTTIE BACKGROUND ANIMATIONS =====
  (function() {
    var script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.12.2/lottie_light.min.js';
    script.onload = function() {
      document.querySelectorAll('[data-lottie-src]').forEach(function(el) {
        var src = el.getAttribute('data-lottie-src');
        if (!src) return;
        var anim = lottie.loadAnimation({
          container: el,
          renderer: 'svg',
          loop: true,
          autoplay: false,
          path: src
        });
        // Trouver la carte parente et brancher les events hover
        var card = el.closest('.service-card-new');
        if (card) {
          card.addEventListener('mouseenter', function() { anim.play(); });
          card.addEventListener('mouseleave', function() { anim.pause(); });
        }
      });
    };
    document.head.appendChild(script);
  })();
</script>

<script>
  // ===== DIAGNOSTIC ATTACHMENT =====
  function sospcBuildMeta(payload) {
    var parts = [];
    if (payload.generated) parts.push(payload.generated);
    if (payload.score != null) parts.push('Score ' + payload.score + '/100');
    var problems = (payload.issues || []).filter(function(i) { return i.level !== 'ok'; }).length;
    if (problems) parts.push(problems + ' problème' + (problems > 1 ? 's' : '') + ' détecté' + (problems > 1 ? 's' : ''));
    if ((payload.symptoms_user || []).length) parts.push((payload.symptoms_user.length) + ' symptôme(s) décrits');
    return parts.join(' · ');
  }

  function sospcAttachDiag(payload) {
    try {
      document.getElementById('diagnostic-data').value = payload.text || JSON.stringify(payload, null, 2);
    } catch(e) {}
    var meta = document.getElementById('dab-meta-text');
    if (meta) meta.textContent = sospcBuildMeta(payload);
    var banner = document.getElementById('diag-attach-banner');
    if (banner) banner.style.display = 'flex';
    var lbl = document.getElementById('contact-submit-label');
    if (lbl) lbl.textContent = 'Envoyer + diagnostic joint';
    // Pré-remplir le sujet
    var subj = document.querySelector('input[name="subject"]');
    if (subj && !subj.value) {
      subj.value = 'Suite diagnostic SOS-PC du ' + (payload.generated || new Date().toLocaleDateString('fr-FR'));
    }
  }

  window.sospcDetachDiag = function() {
    try { document.getElementById('diagnostic-data').value = ''; } catch(e) {}
    var banner = document.getElementById('diag-attach-banner');
    if (banner) banner.style.display = 'none';
    var lbl = document.getElementById('contact-submit-label');
    if (lbl) lbl.textContent = 'Envoyer le message';
    var subj = document.querySelector('input[name="subject"]');
    if (subj && subj.value.startsWith('Suite diagnostic')) subj.value = '';
  };

  // Écoute les events du widget
  window.addEventListener('sospc:attach-diag', function(e) { sospcAttachDiag(e.detail); });
  window.addEventListener('sospc:attach-diag-update', function(e) { sospcAttachDiag(e.detail); });
  window.addEventListener('sospc:diag-reset', function() { window.sospcDetachDiag(); });

  // Auto-attach au chargement si un diagnostic existe en localStorage
  // Note : le rapport texte complet est généré par buildDiagPayload() dans Layout.astro
  // et dispatché via sospc:attach-diag. Ici on ne refait pas ce calcul — on attend
  // l'event du widget qui se déclenche au DOMContentLoaded de Layout.astro si diagData existe.
  document.addEventListener('DOMContentLoaded', function() {
    try {
      var saved = localStorage.getItem('sospc_diagnostic_v1');
      if (!saved) return;
      var data = JSON.parse(saved);
      if (!data.diagReport) return;
      // Payload minimal pour afficher le bandeau — le texte complet viendra de Layout.astro
      var symptoms = (data.chatHistory || []).filter(function(m) { return m.role === 'user'; }).map(function(m) { return m.content; });
      var payload = {
        generated:     data.savedAt ? new Date(data.savedAt).toLocaleString('fr-FR') : '—',
        score:         data.diagReport.score,
        issues:        data.diagReport.issues || [],
        symptoms_user: symptoms,
        text:          data.diagReport.summary || ''
      };
      sospcAttachDiag(payload);
    } catch(e) {}
  });
</script>

<script>
  // Scroll reveal correct :
  // - éléments déjà dans le viewport → visibles immédiatement, pas d'animation
  // - éléments hors viewport → animation d'entrée au scroll
  var revealObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.style.opacity = "1";
        entry.target.style.transform = "translateY(0)";
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.05 });

  document.querySelectorAll(".service-card-new, .portfolio-card, .info-card, .stat").forEach(function(el, i) {
    var rect = el.getBoundingClientRect();
    var inViewport = rect.top < window.innerHeight && rect.bottom > 0;
    if (inViewport) return; // déjà visible, on ne touche pas
    el.style.opacity = "0";
    el.style.transform = "translateY(20px)";
    el.style.transition = "opacity 0.4s ease " + Math.min(i * 0.02, 0.1) + "s, transform 0.4s ease " + Math.min(i * 0.02, 0.1) + "s";
    revealObserver.observe(el);
  });
</script>
