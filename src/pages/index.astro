---
import Layout from '../layouts/Layout.astro';

const portfolioItems = [
  { id: "Artisan", name: "Site Vitrine — Artisan", desc: "Site moderne et responsive pour un artisan local.", url: "https://boutique-artisan.netlify.app", img: "/Portfolio preview/boutique-artisan.png", tags: ["vitrine", "SEO"] },
  { id: "Restaurant", name: "Site Web — Restaurant", desc: "Menu interactif, réservation en ligne, galerie photos.", url: "https://restaurant-template-regal-authentique.netlify.app/", img: "/Portfolio preview/restaurant-regal-authentique.png", tags: ["réservation", "menu"] },
  { id: "Gite", name: "Location de Gîte", desc: "Calendrier de disponibilités, formulaire de réservation.", url: "https://gite-provence.netlify.app/", img: "/Portfolio preview/gite-provence.png", tags: ["tourisme", "réservation"] },
  { id: "Bolt", name: "Projet Bolt DIY", desc: "Site dynamique avec composants interactifs.", url: "https://bolt-diy-16-1746971425202.netlify.app/", img: "/Portfolio preview/VOID-engine.png", tags: ["interactif", "SPA"] },
];
---

<Layout title="SOS-PC — Dépannage & Solutions Informatiques">

  <!-- ===== HERO ===== -->
  <section id="hero" class="hero-section">
    <div class="hero-terminal">
      <div class="terminal-bar">
        <span class="t-dot red"></span>
        <span class="t-dot yellow"></span>
        <span class="t-dot green"></span>
        <span class="t-title">sos-pc.sh — bash</span>
      </div>
      <div class="terminal-body">
        <div class="t-line"><span class="t-prompt">$</span> <span class="t-cmd">whoami</span></div>
        <div class="t-output">sos-pc — expert en dépannage &amp; solutions numériques</div>
        <div class="t-line"><span class="t-prompt">$</span> <span class="t-cmd">cat services.txt</span></div>
        <div class="t-output t-list">
          <span class="t-item ok">✓ Réparation informatique</span>
          <span class="t-item ok">✓ Création de sites web</span>
          <span class="t-item ok">✓ Hébergement streaming</span>
          <span class="t-item warn">~ Hébergement IA (coming soon)</span>
        </div>
        <div class="t-line"><span class="t-prompt">$</span> <span class="t-cursor">_</span></div>
      </div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="tag tag-teal">SOS-PC</span>
        <span class="hero-location mono">// Le Castellet, 04700</span>
      </div>
      <h1 class="hero-title">
        Votre <em>partenaire tech</em><br/>de confiance
      </h1>
      <p class="hero-sub">
        Diagnostic IA, réparation, création web et self-hosting —<br/>des solutions fiables pour particuliers et pros.
      </p>
      <div class="hero-actions">
        <a href="#diagnostic" class="btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          Diagnostic gratuit
        </a>
        <a href="#contact" class="btn-ghost">Demander un devis</a>
      </div>
    </div>
  </section>

  <!-- ===== ABOUT ===== -->
  <section id="about" class="about-section">
    <div class="section-label">
      <span class="tag tag-teal">01</span>
      <span class="mono text-muted">// À propos</span>
    </div>
    <div class="about-grid">
      <div>
        <h2>Solutions fiables,<br/><span class="teal">adaptées à vos besoins</span></h2>
        <p>SOS-PC, dirigé par un auto-entrepreneur passionné, propose une gamme complète de services pour répondre à vos besoins technologiques. Particuliers ou professionnels — nous avons l'expertise qu'il vous faut.</p>
        <div class="about-stats">
          <div class="stat">
            <span class="stat-val mono">04+</span>
            <span class="stat-label">Services proposés</span>
          </div>
          <div class="stat">
            <span class="stat-val mono">24h</span>
            <span class="stat-label">Délai de réponse</span>
          </div>
          <div class="stat">
            <span class="stat-val mono">100%</span>
            <span class="stat-label">Sur mesure</span>
          </div>
        </div>
      </div>
      <div class="about-card-stack">
        <div class="info-card">
          <span class="ic-icon">⚡</span>
          <div>
            <p class="ic-title">Intervention rapide</p>
            <p class="ic-desc">Dépannage à distance ou à domicile dans les Alpes-de-Haute-Provence</p>
          </div>
        </div>
        <div class="info-card">
          <span class="ic-icon">🔒</span>
          <div>
            <p class="ic-title">Données sécurisées</p>
            <p class="ic-desc">Vos données restent privées — aucune revente, aucun partage tiers</p>
          </div>
        </div>
        <div class="info-card">
          <span class="ic-icon">🤝</span>
          <div>
            <p class="ic-title">Accompagnement humain</p>
            <p class="ic-desc">Un interlocuteur unique, disponible et à l'écoute</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SERVICES ===== -->
  <section id="services" class="services-section">
    <div class="section-label">
      <span class="tag tag-teal">02</span>
      <span class="mono text-muted">// Services</span>
    </div>
    <h2 class="section-title">Nos <span class="teal">solutions</span></h2>

    <div class="services-grid">

      <!-- Carte 1 — Réparation (teal) -->
      <div class="service-card-new">
        <div class="sc-lottie sc-lottie--teal" data-lottie-src="/PC-repair/animations/8acfa0f0-493f-445c-a1a3-ae798829ce77.json"></div>
        <div class="sc-header">
          <div class="sc-icon-wrap" style="--ic:#00d4aa">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          </div>
          <span class="tag tag-teal">disponible</span>
        </div>
        <h3>Réparation<br/>Informatique</h3>
        <p>Diagnostic, dépannage, montage sur mesure et optimisation. Nous redonnons vie à votre matériel.</p>
        <ul class="sc-list">
          <li><span class="mono teal">→</span> Diagnostic &amp; dépannage</li>
          <li><span class="mono teal">→</span> Remplacement de composants</li>
          <li><span class="mono teal">→</span> Montage PC personnalisé</li>
          <li><span class="mono teal">→</span> Optimisation &amp; récupération</li>
        </ul>
        <a href="#contact" class="sc-cta">Demander un devis <span>→</span></a>
      </div>

      <!-- Carte 2 — Web (blue) -->
      <div class="service-card-new">
        <div class="sc-lottie sc-lottie--blue" data-lottie-src="/web-design/animations/43f834cb-31ab-428c-acf2-2674d3b07d94.json"></div>
        <div class="sc-header">
          <div class="sc-icon-wrap" style="--ic:#7aa2f7">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </div>
          <span class="tag tag-blue">disponible</span>
        </div>
        <h3>Création de<br/>Sites Web</h3>
        <p>Sites vitrines modernes, responsives et optimisés pour votre présence en ligne.</p>
        <ul class="sc-list">
          <li><span class="mono" style="color:#7aa2f7">→</span> Sites vitrines pro</li>
          <li><span class="mono" style="color:#7aa2f7">→</span> Design responsive</li>
          <li><span class="mono" style="color:#7aa2f7">→</span> SEO de base inclus</li>
          <li><span class="mono" style="color:#7aa2f7">→</span> Fonctionnalités sur mesure</li>
        </ul>
        <a href="#contact" class="sc-cta" style="color:#7aa2f7">Discutons de votre projet <span>→</span></a>
      </div>

      <!-- Carte 3 — Streaming (purple) -->
      <div class="service-card-new">
        <div class="sc-lottie sc-lottie--purple" data-lottie-src="/Streaming/animations/3add7b2a-2592-4274-a7f6-614fcd7bfe31.json"></div>
        <div class="sc-header">
          <div class="sc-icon-wrap" style="--ic:#bb9af7">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M22 12H2M22 12l-4-4M22 12l-4 4M2 12l4-4M2 12l4 4"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <span class="tag tag-purple">disponible</span>
        </div>
        <h3>Hébergement<br/>Streaming</h3>
        <p>Votre propre plateforme média (Jellyfin, etc.) accessible partout, en toute sécurité.</p>
        <ul class="sc-list">
          <li><span class="mono" style="color:#bb9af7">→</span> Installation Jellyfin/similaires</li>
          <li><span class="mono" style="color:#bb9af7">→</span> Conseils matériel/serveur</li>
          <li><span class="mono" style="color:#bb9af7">→</span> Accès sécurisé</li>
          <li><span class="mono" style="color:#bb9af7">→</span> Maintenance de base</li>
        </ul>
        <a href="#contact" class="sc-cta" style="color:#bb9af7">En savoir plus <span>→</span></a>
      </div>

      <!-- Carte 4 — IA (yellow, pas d'animation disponible) -->
      <div class="service-card-new coming-soon">
        <div class="sc-header">
          <div class="sc-icon-wrap" style="--ic:#e0af68">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <span class="tag tag-yellow">coming soon</span>
        </div>
        <h3>Hébergement<br/>Modèles IA</h3>
        <p>Déployez et gérez vos modèles d'IA pour explorer leur potentiel. Service en développement.</p>
        <ul class="sc-list sc-list--dim">
          <li><span class="mono" style="color:#e0af68">→</span> Conseils hébergement</li>
          <li><span class="mono" style="color:#e0af68">→</span> Aide au déploiement</li>
          <li><span class="mono" style="color:#e0af68">→</span> Gestion infrastructure</li>
          <li><span class="mono" style="color:#e0af68">→</span> Contactez-nous pour discuter</li>
        </ul>
        <a href="#contact" class="sc-cta" style="color:#e0af68">Contactez-nous <span>→</span></a>
      </div>

    </div>
  </section>

  <!-- ===== DIAGNOSTIC ===== -->
  <section id="diagnostic" class="diag-section">
    <div class="section-label">
      <span class="tag tag-teal">03</span>
      <span class="mono text-muted">// Diagnostic IA</span>
    </div>
    <div class="diag-grid">
      <div class="diag-content">
        <h2>Diagnostic PC<br/><span class="teal">Intelligent</span></h2>
        <p>Notre IA analyse en profondeur votre système Windows — CPU, RAM, disques, erreurs système — et vous propose un rapport clair avec des recommandations concrètes.</p>
        <div class="diag-features">
          <div class="df-item"><span class="teal mono">✓</span> Analyse complète en 30 secondes</div>
          <div class="df-item"><span class="teal mono">✓</span> Rapport détaillé avec priorités</div>
          <div class="df-item"><span class="teal mono">✓</span> Chat IA pour aller plus loin</div>
          <div class="df-item"><span class="teal mono">✓</span> 100% gratuit, aucune installation</div>
        </div>
        <div class="diag-privacy">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Aucun fichier personnel collecté — uniquement les données techniques système.
        </div>
      </div>
      <div class="diag-terminal">
        <div class="terminal-bar">
          <span class="t-dot red"></span>
          <span class="t-dot yellow"></span>
          <span class="t-dot green"></span>
          <span class="t-title">diagnostic-sos-pc.ps1</span>
        </div>
        <div class="terminal-body">
          <div class="t-line"><span class="t-prompt">PS&gt;</span> <span class="t-cmd">$s='XXXX'; irm sos-pc.click/diag.ps1 | iex</span></div>
          <div class="t-output">Collecte des informations système...</div>
          <div class="t-output t-list">
            <span class="t-item ok">✓ OS Windows 11 Pro</span>
            <span class="t-item ok">✓ CPU Intel i7 — 23% load</span>
            <span class="t-item ok">✓ RAM 16 Go — 68% utilisée</span>
            <span class="t-item warn">⚠ Disque C: 94% utilisé</span>
            <span class="t-item err">✗ 3 erreurs critiques détectées</span>
          </div>
          <div class="t-output teal">Envoi des données vers SOS-PC...</div>
          <div class="t-output" style="color:#00d4aa;font-weight:600">✓ Retournez sur sos-pc.click !</div>
        </div>
        <div class="diag-cta-box">
          <p class="mono" style="font-size:12px;color:var(--text-muted);margin-bottom:8px;">
            // Ouvrez le chatbot → copiez la commande → collez dans PowerShell
          </p>
          <button class="btn-primary" onclick="sospcToggle()" style="width:100%;justify-content:center;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Lancer le diagnostic
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LOCATION ===== -->
  <section id="location" class="location-section">
    <div class="section-label">
      <span class="tag tag-teal">04</span>
      <span class="mono text-muted">// Zone d'intervention</span>
    </div>
    <h2 class="section-title">Zone d'intervention</h2>
    <p class="section-sub">Basé près de Le Castellet (04700), nous intervenons dans les environs.</p>
    <div class="map-wrapper">
      <iframe
        title="Zone d'intervention SOS-PC"
        src="https://maps.google.com/maps?q=Le+Castellet,+04700,+France&t=&z=13&ie=UTF8&iwloc=&output=embed"
        loading="lazy"
        style="border:0;width:100%;height:340px;border-radius:var(--radius-lg);"
        allowfullscreen=""
      ></iframe>
    </div>
  </section>

  <!-- ===== PORTFOLIO ===== -->
  <section id="vitrine" class="portfolio-section">
    <div class="section-label">
      <span class="tag tag-teal">05</span>
      <span class="mono text-muted">// Réalisations</span>
    </div>
    <h2 class="section-title">Notre <span class="teal">vitrine</span></h2>
    <div class="portfolio-grid">
      {portfolioItems.map(item => (
        <a href={item.url} target="_blank" rel="noopener" class="portfolio-card">
          <div class="pc-img-wrap">
            <img src={item.img} alt={item.name} loading="lazy" />
            <div class="pc-overlay">
              <span class="mono" style="font-size:12px;color:var(--accent-hex)">Voir le site →</span>
            </div>
          </div>
          <div class="pc-info">
            <div class="pc-tags">
              {item.tags.map(t => <span class="tag tag-teal" style="font-size:10px">{t}</span>)}
            </div>
            <h3>{item.name}</h3>
            <p>{item.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section id="contact" class="contact-section">
    <div class="section-label">
      <span class="tag tag-teal">06</span>
      <span class="mono text-muted">// Contact</span>
    </div>
    <div class="contact-grid">
      <div>
        <h2>Contactez<br/><span class="teal">SOS-PC</span></h2>
        <p>Pour toute demande d'information ou devis, remplissez le formulaire ou contactez-nous directement.</p>
        <div class="contact-links">
          <a href="tel:+33769561491" class="contact-link cl-phone">
            <span class="cl-logo">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.59 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <div class="cl-text">
              <span class="cl-label mono">Téléphone</span>
              <span class="cl-val">07 69 56 14 91</span>
            </div>
          </a>
          <a href="mailto:sos.pc.04@gmail.com" class="contact-link cl-email">
            <span class="cl-logo">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
            </span>
            <div class="cl-text">
              <span class="cl-label mono">Email</span>
              <span class="cl-val">sos.pc.04@gmail.com</span>
            </div>
          </a>
          <a href="https://discord.gg/APFtmK5PYc" target="_blank" rel="noopener" class="contact-link cl-discord">
            <span class="cl-logo">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
            </span>
            <div class="cl-text">
              <span class="cl-label mono">Discord</span>
              <span class="cl-val">Rejoindre</span>
            </div>
          </a>
          <a href="https://t.me/+pWnKAEiqrJE4NzRk" target="_blank" rel="noopener" class="contact-link cl-telegram">
            <span class="cl-logo">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            </span>
            <div class="cl-text">
              <span class="cl-label mono">Telegram</span>
              <span class="cl-val">Nous écrire</span>
            </div>
          </a>
          <a href="https://www.linkedin.com/in/sos-pc-04700-castellet/" target="_blank" rel="noopener" class="contact-link cl-linkedin">
            <span class="cl-logo">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </span>
            <div class="cl-text">
              <span class="cl-label mono">LinkedIn</span>
              <span class="cl-val">Notre profil</span>
            </div>
          </a>
          <a href="#" class="contact-link cl-whatsapp" aria-label="WhatsApp — bientôt disponible" title="Bientôt disponible">
            <span class="cl-logo">
